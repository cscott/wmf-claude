#!/bin/bash
# Wrapper to launch Claude Code inside the wmf-engineer nono sandbox
# with MCP server access pre-configured.
#
# Usage:
#   bin/claude                              # launch in current directory
#   bin/claude --local-web                  # open localhost web ports (default 80/443/8080) for curl-based testing
#   bin/claude --local-web=8080             # narrow to specific port(s); comma-separated for several
#   bin/claude --chrome                     # also enable chrome-devtools MCP (implies --local-web)
#   bin/claude --docker=mediawiki           # auto-start a Docker exec broker for that compose service,
#                                           # stopped automatically when the session exits
#   bin/claude --docker=auto                # ...detect the service from the compose file
#   bin/claude --docker=mediawiki:/var/www/html/w   # ...and run commands from that in-container dir
#   bin/claude --docker                     # attach to a broker you started yourself
#                                           # (bin/launch-docker-broker, for custom compose-file/workdir)
#   bin/claude --allow ~/src/other-repo --  # grant nono access to additional paths
#   bin/claude --help                       # show wrapper options and exit
#   WMF_CLAUDE_PROFILE=wmf-data-scientist bin/claude   # load profiles/<name>.json (default wmf-engineer)
#
# All flags before "--" are passed to nono. All flags after are passed to claude.
# If no "--" is given, all arguments are passed to claude — so nono flags like
# `--allow`/`--read` need an explicit `--` after them or they'll route to claude.
# `--chrome` and `--local-web` are the exceptions: wmf-claude wrapper flags,
# consumed here regardless of where the separator is.
set -eo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"

# Captured before any parsing so a post-update re-exec can replay the launch
# exactly as the engineer typed it.
ORIG_ARGS=("$@")

# Persistent self-updater state, beside the fetch stamp:
#   update-pending  the checkout moved but setup.sh has not finished (holds the sha)
#   update-refused  the sha a fast-forward last refused, so we stop re-asking for it
WMF_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/wmf-claude"

# `-h`/`--help` as the first arg prints wrapper usage and exits before launching
# (claude's own help is still reachable via `claude -- --help`).
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  cat <<'EOF'
wmf-claude — launch Claude Code inside the wmf-engineer nono sandbox.

Usage: claude [wrapper flags] [nono flags --] [claude args]

Wrapper flags:
  --chrome             enable the chrome-devtools MCP (opens 127.0.0.1:9222; implies --local-web)
  --local-web[=PORTS]  open localhost web ports for curl-based local-wiki testing
                       (default 80,443,8080; comma-separated list to narrow)
  --docker[=SVC[:WD]]  run dev tools (composer/php/npm/vendor/bin/*) in a Docker
                       compose service via the broker. =SVC starts and owns the
                       broker (=auto detects the service); add :WD for the
                       in-container workdir. Bare --docker attaches to one you
                       started with bin/launch-docker-broker.
  --egress=MODE        with --docker=SVC: verify the container was created with
                       the matching templates/docker-egress/ override (MODE is
                       none or allowlist) and refuse to start when it was not.
  -h, --help           show this help

Passthrough (split at --):
  before --   passed to `nono run`  (e.g. --allow DIR, --read DIR)
  after --    passed to Claude Code (with no --, all args go to Claude Code)

Environment:
  WMF_CLAUDE_PROFILE=<name>   load profiles/<name>.json (default: wmf-engineer)
  WMF_CLAUDE_QUIET=1          suppress the WMF banner
  WMF_CLAUDE_SKIP_UPDATE=1    skip update-staleness notices

Refuses --capability-elevation, --trust-override, --dangerously-skip-permissions.
For Claude Code's own flags: claude -- --help
EOF
  exit 0
fi

# Which profiles/<name>.json to load; defaults to wmf-engineer. Lets additional
# profiles (e.g. wmf-data-scientist) be selected without changing this script.
PROFILE="${WMF_CLAUDE_PROFILE:-wmf-engineer}"
PROFILE_PATH="$SCRIPT_DIR/profiles/$PROFILE.json"
if [[ ! -f "$PROFILE_PATH" ]]; then
  echo "error: profile '$PROFILE' not found at $PROFILE_PATH" >&2
  exit 1
fi

NONO_ARGS=()
CLAUDE_ARGS=()
SEEN_SEPARATOR=false

for arg in "$@"; do
  if [[ "$arg" == "--" ]]; then
    SEEN_SEPARATOR=true
    continue
  fi
  if $SEEN_SEPARATOR; then
    CLAUDE_ARGS+=("$arg")
  else
    NONO_ARGS+=("$arg")
  fi
done

# Extract --chrome and --local-web from the nono segment. Must run before the
# no-separator swap below — otherwise `bin/claude --chrome` (the documented
# form, no explicit `--`) silently moves the flag into CLAUDE_ARGS before
# extraction and the wrapper flag is forwarded to claude as an unknown option.
# Restricted to the pre-`--` segment so any future `claude --chrome` flag
# (post-`--`) wouldn't be accidentally consumed.
WANT_CHROME=false
WANT_LOCAL_WEB=false
WANT_DOCKER=false
DOCKER_SERVICE=""   # set by --docker=SERVICE -> bin/claude manages the broker
DOCKER_EGRESS=""    # set by --egress=none|allowlist -> broker verifies isolation
LOCAL_WEB_PORTS=""  # empty -> default set below; --local-web=80,443 narrows it
FILTERED_NONO_ARGS=()
for arg in "${NONO_ARGS[@]}"; do
  if [[ "$arg" == "--chrome" ]]; then
    WANT_CHROME=true
  elif [[ "$arg" == "--local-web" ]]; then
    WANT_LOCAL_WEB=true
  elif [[ "$arg" == --local-web=* ]]; then
    WANT_LOCAL_WEB=true
    LOCAL_WEB_PORTS="${arg#--local-web=}"
  elif [[ "$arg" == "--docker" ]]; then
    WANT_DOCKER=true
  elif [[ "$arg" == --docker=* ]]; then
    WANT_DOCKER=true
    DOCKER_SERVICE="${arg#--docker=}"
  elif [[ "$arg" == --egress=* ]]; then
    DOCKER_EGRESS="${arg#--egress=}"
  else
    FILTERED_NONO_ARGS+=("$arg")
  fi
done
NONO_ARGS=("${FILTERED_NONO_ARGS[@]}")

if [[ -n "$DOCKER_EGRESS" ]]; then
  if [[ "$DOCKER_EGRESS" != "none" && "$DOCKER_EGRESS" != "allowlist" ]]; then
    echo "error: --egress takes 'none' or 'allowlist', got '$DOCKER_EGRESS'" >&2
    exit 1
  fi
  # The verification runs in the broker, so it needs a broker this launcher
  # starts. In attach mode, pass --egress to bin/launch-docker-broker instead.
  if ! $WANT_DOCKER || [[ -z "$DOCKER_SERVICE" ]]; then
    echo "error: --egress requires --docker=SERVICE (managed broker)." >&2
    echo "       For a manually started broker, pass --egress to bin/launch-docker-broker." >&2
    exit 1
  fi
fi

# --chrome implies --local-web: a browser session still wants the cheap
# curl-first tier available (hit the local wiki / api.php without driving
# Chrome or paying the MCP's context cost), escalating to the browser only
# when pixels or interaction are actually needed.
if $WANT_CHROME; then
  WANT_LOCAL_WEB=true
fi

# If no separator was used, treat all args as claude args
if ! $SEEN_SEPARATOR; then
  CLAUDE_ARGS=("${NONO_ARGS[@]}")
  NONO_ARGS=()
fi

# Reject flags that broadly weaken the sandbox.
# Patterns include the `=value` form because clap accepts both `--flag value`
# and `--flag=value` — matching only the bare flag name would let
# `--capability-elevation=true` slip through.
for arg in "${NONO_ARGS[@]}"; do
  case "$arg" in
    --capability-elevation|--capability-elevation=*|--trust-override|--trust-override=*)
      echo "error: $arg is not allowed — it would weaken the sandbox" >&2
      exit 1
      ;;
  esac
done

# `--settings` is single-valued, so a second occurrence wins outright. We pass
# the tool layer that way, so a user-supplied one after `--` would silently
# replace every deny (Bash(ssh:*), WebFetch=ask, the credential globs) with
# whatever that file contains. Refuse rather than quietly drop the layer.
for arg in "${CLAUDE_ARGS[@]}"; do
  case "$arg" in
    --settings|--settings=*)
      echo "error: $arg is not allowed — it would replace the wmf-claude permission layer" >&2
      echo "       (run 'command claude --settings ...' unsandboxed if you need your own)" >&2
      exit 1
      ;;
  esac
done

# Refuse the permission bypass in every spelling Claude Code accepts.
# `--permission-mode bypassPermissions` and `--allow-dangerously-skip-permissions`
# are the same capability as `--dangerously-skip-permissions`: every tool call
# auto-approved, including the WebFetch=ask rule the tool layer exists to keep.
prev_arg=''
for arg in "${CLAUDE_ARGS[@]}"; do
  case "$arg" in
    --dangerously-skip-permissions|--dangerously-skip-permissions=*|\
    --allow-dangerously-skip-permissions|--allow-dangerously-skip-permissions=*|\
    --permission-mode=bypassPermissions)
      echo "error: $arg is not allowed — it would bypass permission checks" >&2
      exit 1
      ;;
    bypassPermissions)
      if [[ "$prev_arg" == "--permission-mode" ]]; then
        echo "error: --permission-mode bypassPermissions is not allowed — it would bypass permission checks" >&2
        exit 1
      fi
      ;;
  esac
  prev_arg="$arg"
done

# Claude Code's own sandbox (sandbox.enabled in ~/.claude/settings*.json) uses
# Apple seatbelt — it can't nest inside the outer nono seatbelt we're about to
# launch. The inner sandbox-exec deadlocks tool calls. Refuse to launch rather
# than hand the engineer a frozen prompt. settings.local.json takes precedence;
# missing files or jq are treated as "no conflict" (jq is a setup.sh hard dep,
# so absence at runtime is anomalous and shouldn't block launches).
if command -v jq >/dev/null 2>&1; then
  # Read raw values (true/false/null). Don't use jq's `//` operator: `// "null"`
  # would coerce an explicit `false` to "null", breaking precedence (a
  # settings.local.json saying false must override a settings.json saying true).
  SANDBOX_MAIN="null"
  SANDBOX_LOCAL="null"
  if [[ -f "$HOME/.claude/settings.json" ]]; then
    SANDBOX_MAIN=$(jq -r '.sandbox.enabled' "$HOME/.claude/settings.json" 2>/dev/null || echo null)
  fi
  if [[ -f "$HOME/.claude/settings.local.json" ]]; then
    SANDBOX_LOCAL=$(jq -r '.sandbox.enabled' "$HOME/.claude/settings.local.json" 2>/dev/null || echo null)
  fi
  SANDBOX_SOURCE=""
  if [[ "$SANDBOX_LOCAL" == "true" ]]; then
    SANDBOX_SOURCE="~/.claude/settings.local.json"
  elif [[ "$SANDBOX_LOCAL" != "false" && "$SANDBOX_MAIN" == "true" ]]; then
    SANDBOX_SOURCE="~/.claude/settings.json"
  fi
  if [[ -n "$SANDBOX_SOURCE" ]]; then
    echo "error: sandbox.enabled is true in $SANDBOX_SOURCE — Claude's in-process sandbox" >&2
    echo "       can't nest inside the nono sandbox bin/claude uses (tool calls deadlock)." >&2
    echo "       Set sandbox.enabled to false in $SANDBOX_SOURCE and retry." >&2
    exit 1
  fi
else
  echo "warning: jq not found on PATH; skipping sandbox.enabled conflict check" >&2
fi

# chrome-devtools MCP is opt-in per session via --chrome. This keeps its
# attack surface (CDP-controlled browser, unrestricted page-side network)
# off when the engineer isn't actively running a manual test. When --chrome
# is set we:
#   - grant the sandbox r+w on the MCP install dir (it writes log/cache files)
#   - open localhost TCP port 9222 so the sandboxed MCP can reach the
#     externally-launched Chrome (kept off the static profile so plain
#     `bin/claude` sessions can't reach a leftover test Chrome)
#   - load the MCP via --mcp-config for this single session
# TODO: the --allow on $CDP_DIR currently covers node_modules/ too — a
# prompt-injected agent could overwrite the MCP binary for the next session.
# Narrow once chrome-devtools-mcp exposes flags for an out-of-tree log/cache dir.
CHROME_DEVTOOLS_ALLOWS=()
CHROME_DEVTOOLS_NONO_ARGS=()
CHROME_DEVTOOLS_CLAUDE_ARGS=()
if $WANT_CHROME; then
  CDP_DIR="$SCRIPT_DIR/chrome-devtools-mcp"
  CDP_CONFIG="$CDP_DIR/mcp-config.json"
  if [[ ! -f "$CDP_CONFIG" ]]; then
    echo "error: --chrome was passed but $CDP_CONFIG is missing" >&2
    echo "       run ./setup.sh with WMF_CLAUDE_SKIP_CHROME unset" >&2
    exit 1
  fi
  if [[ ! -x "$CDP_DIR/node_modules/.bin/chrome-devtools-mcp" ]]; then
    echo "error: --chrome was passed but the MCP binary is missing under $CDP_DIR" >&2
    echo "       run ./setup.sh with WMF_CLAUDE_SKIP_CHROME unset" >&2
    exit 1
  fi
  # Soft warning if Chrome doesn't appear to be running yet — the MCP will
  # still launch, the engineer just needs to start Chrome before driving it.
  if command -v lsof >/dev/null 2>&1 \
     && ! lsof -nP -iTCP:9222 -sTCP:LISTEN >/dev/null 2>&1; then
    echo "note: nothing listening on 127.0.0.1:9222 yet — start Chrome with" >&2
    echo "      bin/launch-test-chrome in another terminal before driving it" >&2
  fi
  CHROME_DEVTOOLS_ALLOWS+=(--allow "$CDP_DIR")
  CHROME_DEVTOOLS_NONO_ARGS+=(--open-port 9222)
  CHROME_DEVTOOLS_CLAUDE_ARGS+=(--mcp-config "$CDP_CONFIG")
fi

# --local-web opens localhost TCP on dev-wiki web ports for curl-based testing
# without loading the MCP. `--open-port` is localhost-only (see `nono run
# --help`), so external egress stays gated by the profile's allow_domain proxy.
# Kept off the static profile so plain sessions can't reach local web services.
# Bare --local-web opens the common set; --local-web=80,443 narrows it. Each
# value is validated as a TCP port before it reaches the nono command line.
LOCAL_WEB_NONO_ARGS=()
if $WANT_LOCAL_WEB; then
  IFS=',' read -ra _LOCAL_WEB_PORTS <<<"${LOCAL_WEB_PORTS:-80,443,8080}"
  for port in "${_LOCAL_WEB_PORTS[@]}"; do
    if [[ ! "$port" =~ ^[0-9]{1,5}$ ]] || (( 10#$port < 1 || 10#$port > 65535 )); then
      echo "error: --local-web port '$port' is not a valid TCP port (1-65535)" >&2
      exit 1
    fi
    LOCAL_WEB_NONO_ARGS+=(--open-port "$port")
  done
fi

# --docker opens a localhost port to the out-of-sandbox Docker exec broker
# (bin/launch-docker-broker). The broker holds the Docker socket — which we must
# NOT hand to the sandbox, since socket access is host root — and only runs
# allowlisted dev-tool verbs inside a pinned container. Same shape as --chrome:
# privileged process outside, port opened per-session (off the static profile),
# in-sandbox client talks over loopback.
#
# Two modes:
#   --docker=SERVICE[:WORKDIR]  managed: bin/claude starts the broker, owns it,
#                     and kills it when the session exits (see cleanup_docker +
#                     the no-exec launch at the bottom). No second terminal.
#                     Optional :WORKDIR sets the in-container working directory
#                     so relative commands (`vendor/bin/phpunit tests/...`) land
#                     in the MediaWiki root rather than the container default.
#   --docker          attach: use a broker you started yourself in another
#                     terminal (for custom compose-file/workdir setups).
#
# Either way the broker writes a 0600 handshake file with {port, token}. We read
# it here (unsandboxed), open exactly that port, and pass the coordinates into
# the sandbox as WMF_DOCKER_* env vars (gated by the profile's allow_vars). The
# sandbox never sees the handshake file, only the token value via env.
#
# We also drop a `mwdocker` symlink into a private dir and prepend it to PATH so
# the in-sandbox shim is a bare command (skills call `mwdocker composer phpcs`,
# matching their allowed-tools so it doesn't prompt). It can't go in
# $SCRIPT_DIR/bin: that dir holds `claude`, and launch-claude.sh's `exec claude`
# would then resolve to this wrapper instead of the real CLI.
DOCKER_BROKER_NONO_ARGS=()
BROKER_PID=""      # set only in managed mode; gates broker teardown in cleanup
MANAGED_HS=""
MANAGED_LOG=""
SHIM_DIR=""
DOCKER_WORKDIR=""
_DOCKER_CLEANED=0
cleanup_docker() {
  [[ "$_DOCKER_CLEANED" == 1 ]] && return 0
  _DOCKER_CLEANED=1
  if [[ -n "${BROKER_PID:-}" ]]; then
    kill "$BROKER_PID" 2>/dev/null || true
    wait "$BROKER_PID" 2>/dev/null || true
  fi
  [[ -n "${MANAGED_HS:-}" ]] && rm -f "$MANAGED_HS"
  [[ -n "${MANAGED_LOG:-}" ]] && rm -f "$MANAGED_LOG"
  [[ -n "${SHIM_DIR:-}" && -d "${SHIM_DIR:-}" ]] && rm -rf "$SHIM_DIR"
}

# Reap artifacts a SIGKILLed session left behind (the EXIT trap can't run then).
# Per-session files are named with the launcher PID; if that PID is gone, the
# session is dead. We then kill the orphaned broker named inside the handshake
# (guarding against PID reuse by checking it's really a launch-docker-broker)
# and remove the handshake + shim dir. A reused launcher PID looks alive, so we
# conservatively leave those files rather than risk killing an innocent process.
sweep_stale_docker_artifacts() {
  local rd="$1" f d pid bpid cmd
  for f in "$rd"/wmf-docker-broker.*.json; do
    [[ -e "$f" ]] || continue
    pid="${f##*/wmf-docker-broker.}"; pid="${pid%.json}"
    [[ "$pid" =~ ^[0-9]+$ ]] || continue
    kill -0 "$pid" 2>/dev/null && continue
    bpid=$(jq -r '.pid // empty' "$f" 2>/dev/null || true)
    if [[ "$bpid" =~ ^[0-9]+$ ]] && kill -0 "$bpid" 2>/dev/null; then
      cmd=$(ps -p "$bpid" -o command= 2>/dev/null || true)
      [[ "$cmd" == *launch-docker-broker* ]] && kill "$bpid" 2>/dev/null || true
    fi
    rm -f "$f"
    rm -rf "$rd/wmf-docker-shim.$pid"
  done
  for d in "$rd"/wmf-docker-shim.*; do
    [[ -e "$d" ]] || continue
    pid="${d##*/wmf-docker-shim.}"
    [[ "$pid" =~ ^[0-9]+$ ]] || continue
    kill -0 "$pid" 2>/dev/null && continue
    rm -rf "$d"
  done
}

if $WANT_DOCKER; then
  if ! command -v jq >/dev/null 2>&1; then
    echo "error: --docker needs jq to read the broker handshake file" >&2
    exit 1
  fi
  RUNTIME_DIR="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}"
  sweep_stale_docker_artifacts "$RUNTIME_DIR"
  # Both modes create the shim dir and need teardown, so trap early and don't
  # exec at the bottom (the shell must outlive nono to run cleanup_docker).
  trap cleanup_docker EXIT INT TERM
  SHIM_DIR="$RUNTIME_DIR/wmf-docker-shim.$$"
  mkdir -p "$SHIM_DIR"
  chmod 700 "$SHIM_DIR"   # private even if RUNTIME_DIR fell back to world-writable /tmp
  ln -sf "$SCRIPT_DIR/bin/mwdocker" "$SHIM_DIR/mwdocker"
  DOCKER_BROKER_NONO_ARGS+=(--read "$SHIM_DIR")
  export PATH="$SHIM_DIR:$PATH"

  if [[ -n "$DOCKER_SERVICE" ]]; then
    # Split SERVICE[:WORKDIR]. Service names can't contain ':'; an absolute
    # in-container path can, but we only split on the first colon.
    if [[ "$DOCKER_SERVICE" == *:* ]]; then
      DOCKER_WORKDIR="${DOCKER_SERVICE#*:}"
      DOCKER_SERVICE="${DOCKER_SERVICE%%:*}"
    fi
    # Managed broker: start it ourselves and tie its lifetime to this session.
    if ! command -v python3 >/dev/null 2>&1; then
      echo "error: --docker=$DOCKER_SERVICE needs python3 to run the broker" >&2
      exit 1
    fi
    COMPOSE_FILE=""
    for f in docker-compose.yml docker-compose.yaml compose.yml compose.yaml; do
      if [[ -f "$PWD/$f" ]]; then COMPOSE_FILE="$PWD/$f"; break; fi
    done
    if [[ -z "$COMPOSE_FILE" ]]; then
      echo "error: --docker=$DOCKER_SERVICE found no compose file in $PWD" >&2
      echo "       (looked for docker-compose.yml/.yaml, compose.yml/.yaml)" >&2
      echo "       for a custom layout, start the broker yourself and use bare --docker:" >&2
      echo "         bin/launch-docker-broker --service $DOCKER_SERVICE --compose-file <path>" >&2
      exit 1
    fi
    # Resolve the service name against the compose file (best-effort; needs
    # docker to parse it). `--docker=auto` picks one; an explicit name is
    # validated so a typo fails fast with the real list instead of a cryptic
    # "no such service" mid-session.
    DOCKER_SERVICES=""
    if command -v docker >/dev/null 2>&1; then
      DOCKER_SERVICES=$(docker compose -f "$COMPOSE_FILE" config --services 2>/dev/null || true)
    fi
    if [[ "$DOCKER_SERVICE" == "auto" ]]; then
      if [[ -z "$DOCKER_SERVICES" ]]; then
        echo "error: --docker=auto could not read services from $COMPOSE_FILE" >&2
        echo "       (need docker on PATH to parse it); name the service explicitly: --docker=NAME" >&2
        exit 1
      fi
      if printf '%s\n' "$DOCKER_SERVICES" | grep -qx mediawiki; then
        DOCKER_SERVICE=mediawiki
      elif [[ "$(printf '%s\n' "$DOCKER_SERVICES" | grep -c .)" == "1" ]]; then
        DOCKER_SERVICE=$(printf '%s\n' "$DOCKER_SERVICES" | grep . | head -n1)
      else
        echo "error: --docker=auto found multiple services; pick one with --docker=NAME:" >&2
        printf '%s\n' "$DOCKER_SERVICES" | grep . | sed 's/^/         /' >&2
        exit 1
      fi
      echo "note: --docker=auto selected service '$DOCKER_SERVICE'" >&2
    elif [[ -n "$DOCKER_SERVICES" ]] && ! printf '%s\n' "$DOCKER_SERVICES" | grep -qx "$DOCKER_SERVICE"; then
      echo "error: '$DOCKER_SERVICE' is not a service in $COMPOSE_FILE. Available:" >&2
      printf '%s\n' "$DOCKER_SERVICES" | grep . | sed 's/^/         /' >&2
      exit 1
    fi
    BROKER_WORKDIR_ARGS=()
    [[ -n "$DOCKER_WORKDIR" ]] && BROKER_WORKDIR_ARGS=(--workdir "$DOCKER_WORKDIR")
    BROKER_EGRESS_ARGS=()
    [[ -n "$DOCKER_EGRESS" ]] && BROKER_EGRESS_ARGS=(--egress "$DOCKER_EGRESS")
    # Per-session handshake/log keyed on our PID so concurrent sessions don't
    # clobber each other (the manual broker uses a single fixed path instead).
    MANAGED_HS="$RUNTIME_DIR/wmf-docker-broker.$$.json"
    MANAGED_LOG="$RUNTIME_DIR/wmf-docker-broker.$$.log"
    rm -f "$MANAGED_HS"
    python3 "$SCRIPT_DIR/bin/launch-docker-broker" \
      --service "$DOCKER_SERVICE" \
      --compose-file "$COMPOSE_FILE" \
      "${BROKER_WORKDIR_ARGS[@]}" \
      ${BROKER_EGRESS_ARGS[@]+"${BROKER_EGRESS_ARGS[@]}"} \
      --handshake "$MANAGED_HS" \
      >"$MANAGED_LOG" 2>&1 &
    BROKER_PID=$!
    # Wait for the broker to bind and write its handshake. It calls listen()
    # (in the ThreadingHTTPServer constructor) before writing the file, so the
    # file's presence means the port is already accepting connections.
    HS_FILE="$MANAGED_HS"
    waited=0
    while [[ ! -f "$HS_FILE" ]]; do
      if ! kill -0 "$BROKER_PID" 2>/dev/null; then
        echo "error: the Docker broker exited during startup. Log:" >&2
        sed 's/^/  /' "$MANAGED_LOG" >&2 2>/dev/null || true
        exit 1
      fi
      if (( waited >= 50 )); then
        echo "error: the Docker broker did not come up within 5s. Log:" >&2
        sed 's/^/  /' "$MANAGED_LOG" >&2 2>/dev/null || true
        exit 1
      fi
      sleep 0.1
      (( waited++ )) || true
    done
    echo "note: started a managed Docker broker for '$DOCKER_SERVICE' (pid $BROKER_PID); it stops when this session exits" >&2
  else
    # Attach to a broker the engineer started manually in another terminal.
    HS_FILE="$RUNTIME_DIR/wmf-docker-broker.json"
    if [[ ! -f "$HS_FILE" ]]; then
      echo "error: --docker was passed but no broker handshake at $HS_FILE" >&2
      echo "       either let bin/claude manage it:  bin/claude --docker=mediawiki" >&2
      echo "       or start one yourself in another terminal:" >&2
      echo "         bin/launch-docker-broker --service mediawiki" >&2
      exit 1
    fi
  fi

  BROKER_PORT=$(jq -r '.port' "$HS_FILE" 2>/dev/null || echo "")
  BROKER_TOKEN=$(jq -r '.token' "$HS_FILE" 2>/dev/null || echo "")
  # In attach mode the broker was started manually; its handshake records the
  # verified egress mode (empty when the broker ran without --egress).
  if [[ -z "$DOCKER_EGRESS" ]]; then
    DOCKER_EGRESS=$(jq -r '.egress // empty' "$HS_FILE" 2>/dev/null || echo "")
  fi
  if [[ ! "$BROKER_PORT" =~ ^[0-9]+$ ]] || [[ -z "$BROKER_TOKEN" || "$BROKER_TOKEN" == "null" ]]; then
    echo "error: broker handshake $HS_FILE is malformed (no port/token)" >&2
    exit 1
  fi
  # Confirm the broker is actually up before we promise the session a working
  # broker — a stale handshake file outlives a SIGKILLed broker. Prefer lsof;
  # fall back to a /health probe where lsof is absent (common on Linux), so the
  # check doesn't silently no-op and let a dead handshake through.
  broker_dead=""
  if command -v lsof >/dev/null 2>&1; then
    lsof -nP -iTCP:"$BROKER_PORT" -sTCP:LISTEN >/dev/null 2>&1 || broker_dead=1
  elif command -v curl >/dev/null 2>&1; then
    curl -fsS --max-time 2 -o /dev/null "http://127.0.0.1:$BROKER_PORT/health" 2>/dev/null || broker_dead=1
  else
    echo "warning: cannot verify the broker is alive (no lsof or curl on PATH)" >&2
  fi
  if [[ -n "$broker_dead" ]]; then
    echo "error: broker handshake points at port $BROKER_PORT but it's not responding" >&2
    echo "       the broker may have been killed; restart it" >&2
    exit 1
  fi
  DOCKER_BROKER_NONO_ARGS+=(--open-port "$BROKER_PORT")
  export WMF_DOCKER_BROKER_URL="http://127.0.0.1:$BROKER_PORT"
  export WMF_DOCKER_BROKER_TOKEN="$BROKER_TOKEN"
  # Surface the largest --docker caveat at the moment of opt-in, not only in
  # the docs: the profile's network allowlist does not cover the container.
  # With --egress the broker verified the container's isolation, so print the
  # verified posture instead. The TUI clears the screen right after launch, so
  # on the first unrestricted use (no acknowledgment marker) wait for Enter —
  # only on an interactive terminal, so scripts and tests never hang.
  if [[ "$DOCKER_EGRESS" == "none" ]]; then
    echo "note: --egress=none verified: the container has no network route out." >&2
  elif [[ "$DOCKER_EGRESS" == "allowlist" ]]; then
    echo "note: --egress=allowlist verified: the container reaches only the" >&2
    echo "      hosts in your squid allowlist (exfil to those hosts remains)." >&2
  else
    echo "warning: --docker: the container's network is NOT sandbox-restricted;" >&2
    echo "         code run via mwdocker has full egress. Keep secrets out of the" >&2
    echo "         dev checkout and dev DB. See docs/security-rationale.md (Docker exec broker)," >&2
    echo "         or use --egress=none|allowlist with a templates/docker-egress/" >&2
    echo "         compose override to restrict the container." >&2
    DOCKER_ACK_FILE="$HOME/.config/wmf-claude/docker-egress-ack"
    if [[ ! -f "$DOCKER_ACK_FILE" && -t 0 && -t 1 ]]; then
      read -r -p "Press Enter to acknowledge (asked once): "
      mkdir -p "$(dirname "$DOCKER_ACK_FILE")"
      touch "$DOCKER_ACK_FILE"
    fi
  fi
fi

# Update notices. bin/claude runs UNSANDBOXED (it's what launches nono), so
# unlike the in-sandbox `claude` session it can reach the network and the
# install repo's .git. We never update silently: pulling and then running the
# freshly-pulled launcher executes code the engineer hasn't seen, which the
# threat model avoids. Instead we print the commits that would land and ask.
# Saying yes is informed consent to a reviewed list, not a blind auto-update,
# and saying nothing (the default) still just prints the command.
# Two checks, shown only in an interactive terminal (skipped for `claude -p`
# and embeddings like the VS Code extension):
#   1. nono vs the .nono-version pin (local, instant).
#   2. wmf-claude behind origin/main, measured from the local tracking ref
#      (instant). A `git fetch origin` refreshes that ref in the background,
#      throttled to once/24h, so it never blocks a launch and is offline-safe.
# Opt out with WMF_CLAUDE_SKIP_UPDATE=1 (the same knob setup.sh honors).
# The one manual update command, printed from three places. Kept here so a
# change (this branch already added the submodule step once) lands everywhere.
print_update_cmd() {  # $1 c_cmd  $2 c_off
  printf '      %sgit -C %s pull && git -C %s submodule update --init --recursive && %s/setup.sh%s\n' \
    "$1" "$SCRIPT_DIR" "$SCRIPT_DIR" "$SCRIPT_DIR" "$2" >&2
}

# Shown while update-pending exists: on the launch that broke and on every launch
# after it, until setup.sh succeeds (bin/wmf-claude-setup clears the marker). A
# one-shot line is not enough: the relaunch's banners scroll it away, and with
# HEAD already current nothing else will ever mention it again.
print_incomplete_warning() {  # $1 c_note  $2 c_off  $3 c_cmd
  printf '\n%sUPDATE INCOMPLETE%s — the checkout moved but setup did not finish.\n' "$1" "$2" >&2
  printf 'Finish it (this notice repeats until setup.sh succeeds):\n' >&2
  printf '  %sgit -C %s submodule update --init --recursive && %s/setup.sh%s\n\n' \
    "$3" "$SCRIPT_DIR" "$SCRIPT_DIR" "$2" >&2
}

# Apply a pending update, then hand the session to the new launcher.
#
# `git merge --ff-only` against the sha we listed, never `git pull` (which
# re-fetches and follows the configured upstream). The submodule step is not
# optional:
# `git pull` leaves submodule worktrees at their old SHAs, and
# bin/wmf-claude-build only initializes submodules when they are *missing*, so
# without this a submodule bump silently keeps the stale MCP server.
#
# On success we exec rather than return: setup.sh may have rewritten this very
# file, and bash reads a script lazily, so continuing would parse whatever now
# sits at the old byte offset. exec replaces the process before that can happen.
# Any failure returns non-zero and the caller falls through to launching the
# current (un-updated) version, so a broken update never blocks work.
do_self_update() {
  # Everything passed explicitly rather than relied on via dynamic scope.
  local c_note="$1" c_off="$2" c_cmd="$3" target="$4"
  [[ -n "$target" ]] || return 1
  printf '\n' >&2
  mkdir -p "$WMF_CACHE_DIR" 2>/dev/null || true

  # `git merge --ff-only <the sha we listed>` rather than `git pull`: pull
  # re-fetches first and follows the branch's configured upstream, so it can
  # land commits that were never shown, or a different ref entirely on a fork.
  # Merging the exact sha the behind-count and the commit list came from is
  # what makes the engineer's yes informed consent to what they just read.
  if ! git -C "$SCRIPT_DIR" merge --ff-only "$target"; then
    printf '%snote:%s update failed; continuing on the current version\n' \
      "$c_note" "$c_off" >&2
    # Remember the sha so we stop asking on every launch. update_notices prints
    # the manual command for it instead, until origin/main moves on.
    printf '%s\n' "$target" > "$WMF_CACHE_DIR/update-refused" 2>/dev/null || true
    return 1
  fi

  # Past this point the checkout HAS moved: HEAD is at origin/main, the
  # behind-count is 0, and the prompt will never fire again. So the half-done
  # state is persisted, not just printed — the marker makes every later launch
  # warn until setup.sh finishes. Ctrl-C anywhere in here exits via the
  # caller's INT trap; the EXIT trap tears down any broker; the marker carries
  # the warning to the next launch. (setup.sh is interactive and may ask for a
  # Phabricator username, so Ctrl-C here is a realistic path.)
  printf '%s\n' "$target" > "$WMF_CACHE_DIR/update-pending" 2>/dev/null || true
  if git -C "$SCRIPT_DIR" submodule update --init --recursive \
     && "$SCRIPT_DIR/setup.sh"; then
    rm -f "$WMF_CACHE_DIR/update-pending"
  else
    print_incomplete_warning "$c_note" "$c_off" "$c_cmd"
  fi

  # exec does not run EXIT traps. A managed Docker broker may be running and
  # holds the host Docker socket, so tear it down by hand or it is orphaned
  # with no owner and no handshake file naming it.
  # `|| true`: cleanup_docker ends in a `[[ ... ]] && rm` that returns 1 when
  # no broker ran, which is harmless in a trap but would abort us here.
  cleanup_docker || true
  trap - EXIT INT TERM

  # Guards against an exec loop if the behind-count somehow survives the merge.
  export WMF_CLAUDE_UPDATED=1
  exec "$SCRIPT_DIR/bin/claude" "${ORIG_ARGS[@]}"
}

update_notices() {
  [[ -n "${WMF_CLAUDE_SKIP_UPDATE:-}" ]] && return 0

  # Only nag a human at an interactive terminal. `[[ -t 2 ]]` is false when
  # stderr is captured (the VS Code extension run headless, piped output), so
  # we stay silent and skip the background fetch there. The arg scan catches
  # `claude -p` run from a terminal, where stderr is still a TTY.
  [[ -t 2 ]] || return 0
  local a
  for a in "${CLAUDE_ARGS[@]}"; do
    case "$a" in -p|--print|--print=*) return 0 ;; esac
  done

  # Colorize the notices so they stand out against nono's colored capability
  # table; an uncolored note at the top is easy to miss. Only reached when
  # stderr is a TTY (checked above); also honors NO_COLOR. Bold yellow labels
  # the "note:"; bold magenta marks the copy-paste command, matching the
  # banner's convention (launch-claude.sh) of magenta for things you act on.
  local c_note='' c_cmd='' c_off=''
  if [[ -z "${NO_COLOR:-}" ]]; then
    c_note=$'\033[1;33m'
    c_cmd=$'\033[1;35m'
    c_off=$'\033[0m'
  fi

  # A previous self-update moved the checkout but setup.sh did not finish.
  # Repeats every launch until it does; see print_incomplete_warning.
  if [[ -f "$WMF_CACHE_DIR/update-pending" ]]; then
    print_incomplete_warning "$c_note" "$c_off" "$c_cmd"
  fi

  # 1. Installed nono older than the pin.
  if command -v nono >/dev/null 2>&1 && [[ -f "$SCRIPT_DIR/.nono-version" ]]; then
    local pin have
    pin=$(tr -d '[:space:]' < "$SCRIPT_DIR/.nono-version")
    have=$(nono --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n1)
    # Older = the smaller of the two under version sort, and they differ.
    if [[ -n "$pin" && -n "$have" && "$have" != "$pin" \
          && "$(printf '%s\n%s\n' "$pin" "$have" | sort -V | head -n1)" == "$have" ]]; then
      printf '%snote:%s nono %s is older than the pinned %s; run %sbrew upgrade nono%s\n' \
        "$c_note" "$c_off" "$have" "$pin" "$c_cmd" "$c_off" >&2
    fi
  fi

  # 2. wmf-claude checkout behind origin/main (only inside a git checkout).
  git -C "$SCRIPT_DIR" rev-parse --git-dir >/dev/null 2>&1 || return 0

  # Measured against origin/main, the install's canonical branch, not the
  # current branch's upstream. An engineer may have a feature branch checked
  # out in their install, but "is my install stale?" is always a question about
  # origin/main. Computed from the local tracking ref (no network), so it's
  # instant and drops to 0 the moment they pull.
  local behind
  if git -C "$SCRIPT_DIR" rev-parse --verify --quiet refs/remotes/origin/main >/dev/null; then
    # Resolve the ref to a SHA once and use it for the count, the listing and
    # the merge. A background `git fetch` from a concurrent launch can advance
    # refs/remotes/origin/main while we block on the prompt, which would land
    # commits the engineer never saw.
    local UPDATE_TARGET
    UPDATE_TARGET=$(git -C "$SCRIPT_DIR" rev-parse refs/remotes/origin/main 2>/dev/null || echo "")
    [[ -n "$UPDATE_TARGET" ]] || return 0
    behind=$(git -C "$SCRIPT_DIR" rev-list --count "HEAD..$UPDATE_TARGET" 2>/dev/null || echo 0)
    if [[ "$behind" =~ ^[0-9]+$ ]] && (( behind > 0 )); then
      printf '%snote:%s wmf-claude is %s commit(s) behind origin/main:\n' \
        "$c_note" "$c_off" "$behind" >&2

      # Show what would land. The prompt below is only meaningful if the
      # engineer can see what they're agreeing to; capped so a long gap can't
      # scroll nono's capability table off the screen.
      local log_max=10
      # `|| true`: under `set -eo pipefail` a failing pipeline exits the whole
      # launcher. A shallow clone or a gc mid-flight must not stop Claude Code
      # from starting over a cosmetic notice.
      { git -C "$SCRIPT_DIR" log --oneline --no-decorate -n "$log_max" \
          "HEAD..$UPDATE_TARGET" 2>/dev/null | sed 's/^/      /' >&2; } || true
      (( behind > log_max )) && \
        printf '      ... and %s more\n' "$(( behind - log_max ))" >&2

      # Only offer to self-update a checkout where a fast-forward is safe and
      # unambiguous: on main, nothing uncommitted, a readable tty to prompt on,
      # and not already re-executed after an update this launch. Anything else
      # (feature branch, dirty tree, piped stdin) falls back to printing the
      # command, so we never touch an engineer's in-progress work for them.
      local can_prompt=1 why='' refused=''
      [[ -n "${WMF_CLAUDE_UPDATED:-}" ]] && can_prompt=0
      # A refusal recorded for an older revision is stale once origin/main moves.
      [[ -f "$WMF_CACHE_DIR/update-refused" ]] && refused=$(cat "$WMF_CACHE_DIR/update-refused" 2>/dev/null || true)
      [[ -n "$refused" && "$refused" != "$UPDATE_TARGET" ]] && rm -f "$WMF_CACHE_DIR/update-refused"
      # Needs a tty on stdin too, not just stderr. A background launch is
      # handled at the read itself (SIGTTIN ignored) rather than by detecting
      # the foreground pgrp, which needs `ps` and fails closed where `ps` is
      # restricted — that would silently disable the prompt.
      [[ -r /dev/tty && -t 0 ]] || can_prompt=0
      if [[ "$(git -C "$SCRIPT_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null)" != "main" ]]; then
        can_prompt=0; why=' (install is not on main)'
      # Tracked changes only. `git status --porcelain` also reports untracked
      # files, and Claude Code drops .claude/settings.local.json into any repo
      # where a permission is approved — including this checkout — which would
      # disable the prompt permanently on a perfectly updatable install.
      # A fast-forward only cares about tracked modifications.
      elif ! git -C "$SCRIPT_DIR" diff --quiet --ignore-submodules=dirty HEAD 2>/dev/null; then
        can_prompt=0; why=' (install has uncommitted changes)'
      # Local commits on main mean `merge --ff-only` will refuse. Without this
      # the prompt would appear, fail, and reappear on every single launch.
      elif ! git -C "$SCRIPT_DIR" merge-base --is-ancestor HEAD "$UPDATE_TARGET" 2>/dev/null; then
        can_prompt=0; why=' (install has diverged from main)'
      # The fast-forward to this exact revision was refused last time (an
      # untracked file upstream now tracks, a hook, a locked index). Asking
      # again each launch only repeats the failure, so print the command until
      # origin/main moves on.
      elif [[ "$refused" == "$UPDATE_TARGET" ]]; then
        can_prompt=0; why=' (the last attempt to update to this revision failed)'
      fi

      if (( can_prompt )); then
        local reply=''
        printf '\n      %sUpdate now?%s [y/N] ' "$c_cmd" "$c_off" >&2
        # Timeout so an unattended launch proceeds instead of hanging at the
        # prompt; no answer means no, same as declining.
        # One INT owner from here until do_self_update returns: Ctrl-C at the
        # prompt, during the merge, or inside setup.sh all end the launch. With
        # --docker the EXIT trap then tears the broker down cleanly. The
        # alternative — letting cleanup_docker run as the INT handler and then
        # continuing — launches a session against a dead broker. do_self_update
        # returns only on a pre-merge failure; success execs and never returns.
        trap 'printf "\n" >&2; exit 130' INT
        # Ignoring SIGTTIN makes a read from a background process group fail
        # with EIO instead of suspending the job ("Stopped (tty input)"), so
        # `claude &` declines and launches rather than hanging.
        trap '' TTIN
        read -t 60 -r reply </dev/tty || reply=''
        trap - TTIN
        printf '\n' >&2   # `read` ate the newline; keep later output on its own line
        case "$reply" in
          [yY]|[yY][eE][sS]) do_self_update "$c_note" "$c_off" "$c_cmd" "$UPDATE_TARGET" || true ;;
          *) printf '      skipped; update later with:\n' >&2
             print_update_cmd "$c_cmd" "$c_off" ;;
        esac
        if $WANT_DOCKER; then trap cleanup_docker EXIT INT TERM; else trap - INT; fi
      else
        printf '      update with%s\n' "$why" >&2
        print_update_cmd "$c_cmd" "$c_off"
      fi
    fi
  fi

  # Refresh the remote-tracking ref in the background so the count above stays
  # current. Throttled to once/24h; never blocks or prompts (BatchMode ssh, no
  # terminal prompt, short connect timeout); detached from stdin/tty. Offline
  # or auth failures are ignored; the count just keeps using the last fetch.
  local cache_dir stamp now last interval
  cache_dir="$WMF_CACHE_DIR"
  stamp="$cache_dir/last-fetch"
  mkdir -p "$cache_dir" 2>/dev/null || return 0
  interval=86400
  now=$(date +%s)
  last=0
  [[ -f "$stamp" ]] && last=$(cat "$stamp" 2>/dev/null || echo 0)
  [[ "$last" =~ ^[0-9]+$ ]] || last=0
  if (( now - last < interval )); then
    return 0
  fi
  echo "$now" > "$stamp" 2>/dev/null || true
  (
    cd "$SCRIPT_DIR" || exit 0
    GIT_TERMINAL_PROMPT=0 \
    GIT_SSH_COMMAND='ssh -o BatchMode=yes -o ConnectTimeout=5' \
      git fetch --quiet origin 2>/dev/null || exit 0
  ) </dev/null >/dev/null 2>&1 &
}
update_notices

# Launch claude inside the nono sandbox via launch-claude.sh, which prints
# the WMF Claude banner after nono's capability table (so it lands right
# before Claude Code's banner instead of getting scrolled past).
#
# --read grants the plugin code + MCP submodule dirs under the repo. The user's
# CWD is granted via the profile's filesystem.allow on $WORKDIR (--workdir is
# implicit — nono resolves it to the launch cwd). We don't pass --allow-cwd:
# it's broken on Linux 0.51-0.53 (the runtime grant silently fails and breaks
# cat/ls/env), and the profile grant covers it. Drop this note once upstream
# lands a fix.
#
# --profile loads $PROFILE by path (nono accepts NAME_OR_PATH); `extends:
# claude-code` still resolves. No copy into ~/.config/nono/profiles to drift.
# The Claude Code permission layer, applied per-launch rather than installed
# into ~/.claude/settings.json. `--settings` loads additional settings for this
# session only, so the denies bind sandboxed wmf-claude sessions and leave every
# other Claude Code session on the machine exactly as the engineer configured
# it. The file is inside SCRIPT_DIR, which the sandbox already grants read.
# Verified: with --settings the shipped file refuses `ssh -V` (Bash(ssh:*));
# without it the same command runs. SECURITY.md documents the check.
# Hard-fail rather than launch without it: every other missing-precondition in
# this script errors out, and this is the security-relevant one. Failing open
# would start a session with WebFetch auto-allowed and ssh un-denied, silently.
if [[ ! -f "$SCRIPT_DIR/wiring/settings-merge.json" ]]; then
  echo "error: wiring/settings-merge.json missing — refusing to launch without" >&2
  echo "       the Claude Code permission layer. Re-run ./setup.sh or restore it." >&2
  exit 1
fi
SETTINGS_CLAUDE_ARGS=(--settings "$SCRIPT_DIR/wiring/settings-merge.json")

# Warn when the policy this launch will enforce differs from what is committed.
# With the checkout as the workdir the agent can rewrite these files through
# Bash, and an Edit deny cannot stop that (and a cwd-relative one would block
# every other repo's wiring/ or profiles/ directory), so the launcher checks
# instead. A warning, not a refusal: a maintainer editing the profile is the
# common case and knows they did — an unexpected one here is the signal.
if git -C "$SCRIPT_DIR" rev-parse --git-dir >/dev/null 2>&1; then
  policy_rc=0
  git -C "$SCRIPT_DIR" diff --quiet HEAD -- wiring/settings-merge.json profiles 2>/dev/null || policy_rc=$?
  if (( policy_rc == 1 )); then
    if [[ -z "${NO_COLOR:-}" ]]; then printf '\033[1;33mnote:\033[0m' >&2; else printf 'note:' >&2; fi
    printf ' the security policy differs from the committed version:\n' >&2
    { git -C "$SCRIPT_DIR" diff --stat HEAD -- wiring/settings-merge.json profiles 2>/dev/null \
        | sed 's/^/      /' >&2; } || true
    printf '      If you did not make this change, stop and run: git -C %s diff\n' "$SCRIPT_DIR" >&2
  fi
fi

NONO_CMD=(nono run --profile "$PROFILE_PATH" \
  --read "$SCRIPT_DIR" \
  --allow "$SCRIPT_DIR/mcp-phabricator" \
  --allow "$SCRIPT_DIR/gerrit-mcp-server" \
  "${CHROME_DEVTOOLS_ALLOWS[@]}" \
  "${CHROME_DEVTOOLS_NONO_ARGS[@]}" \
  "${LOCAL_WEB_NONO_ARGS[@]}" \
  "${DOCKER_BROKER_NONO_ARGS[@]}" \
  "${NONO_ARGS[@]}" \
  -- "$SCRIPT_DIR/bin/launch-claude.sh" --plugin-dir "$SCRIPT_DIR" \
  "${SETTINGS_CLAUDE_ARGS[@]}" \
  "${CHROME_DEVTOOLS_CLAUDE_ARGS[@]}" \
  "${CLAUDE_ARGS[@]}")

# With --docker we must NOT exec: the shell has to outlive nono to run
# cleanup_docker via the EXIT/INT/TERM trap (tear down a managed broker, remove
# the shim dir). nono runs in the foreground so the interactive TUI keeps the
# controlling terminal, then the trap fires. Every other path keeps exec — no
# extra process in the tree, unchanged signal semantics.
if $WANT_DOCKER; then
  "${NONO_CMD[@]}"
else
  exec "${NONO_CMD[@]}"
fi
