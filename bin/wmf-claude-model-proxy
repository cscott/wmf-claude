#!/usr/bin/env python3
"""Model API proxy for a contained Lima VM (runs on the HOST, outside the VM).

The contained VM has no egress. Its only path out is this proxy, which
bin/claude-vm forwards into the guest as a localhost port (ssh -R). The
Claude OAuth token stays here, on the host: the VM, and everything in it,
never sees it.

The proxy is the security boundary for model access, so it is strict:
  - Exact paths: POST /v1/messages and POST /v1/messages/count_tokens only.
    The query string is passed on; it does not take part in the match.
  - One request per connection. The request must have Content-Length and no
    Transfer-Encoding. The proxy reads exactly that many bytes, forwards
    them, and closes. Nothing after the body is read, so a second, pipelined
    request never reaches the API.
  - The client's credentials are dropped (Authorization, x-api-key, Cookie,
    Proxy-*), and the host token is injected. A key from inside the VM can
    never reach the API.
  - The body must be a JSON object with no mcp_servers and no container,
    every tool must be a client tool (no "type", or "custom"), and every
    content "source", at any depth, must be inline (base64, text or
    content). Server tools such as web_search, the MCP connector and URL
    sources all make the API reach the internet for the agent.
  - TLS to api.anthropic.com is verified. The response streams back as it
    arrives (server-sent events).
  - Every request is logged, allowed or denied, as one JSON line.

Usage:
  bin/wmf-claude-model-proxy --socket PATH --log PATH [--capture PATH.jsonl.gz] \\
      (--keychain-service S --keychain-account A | --token-file PATH)

--capture writes a per-session transcript on the host: a request record before
each call reaches the API and a response record after, linked by an id (calls
can run in parallel), one gzip member each. It records what the agent sent and
received, never the outbound headers (so never the injected token), and the
file is on the host, out of the VM's reach. Fail closed: the proxy refuses to
start if it cannot open the file, a request it cannot record is not forwarded,
and the session stops when a write fails or the byte budget
(WMF_CLAUDE_CAPTURE_MAX_BYTES) is reached.
"""

import argparse
import gzip
import hashlib
import http.client
import json
import os
import signal
import socketserver
import ssl
import stat
import subprocess
import sys
import threading
import time
import uuid

UPSTREAM_HOST = "api.anthropic.com"
ALLOWED = {("POST", "/v1/messages"), ("POST", "/v1/messages/count_tokens")}
MAX_HEADER_BYTES = 64 * 1024
MAX_BODY_BYTES = 32 * 1024 * 1024
# The transcript keeps at most this much of a response; the rest is marked
# truncated. The request body is already bounded by MAX_BODY_BYTES.
CAPTURE_RESP_MAX = 16 * 1024 * 1024
# A refused body is kept only as a prefix plus a digest of the whole, so a
# stream of refusals (free to the agent) cannot write the whole body each time.
CAPTURE_DENY_REQ_MAX = 64 * 1024
# The whole transcript of one session is bounded, in compressed bytes; the
# session stops when it is reached, so the agent cannot fill the host disk.
# Generous for a real session; WMF_CLAUDE_CAPTURE_MAX_BYTES overrides it.
CAPTURE_SESSION_MAX_DEFAULT = 2 * 1024 * 1024 * 1024
# Reading the request must not hold a thread forever. The response may stream
# for minutes, so the limit applies only until the body is read.
REQUEST_TIMEOUT = 60
UPSTREAM_TIMEOUT = 600
# Hop-by-hop, credential and framing headers. The proxy sets its own.
DROP_HEADERS = {
    "authorization", "x-api-key", "cookie", "host", "content-length",
    "transfer-encoding", "connection", "keep-alive", "te", "trailer",
    "upgrade", "expect", "accept-encoding",
}
DROP_RESPONSE_HEADERS = {
    "connection", "keep-alive", "transfer-encoding", "content-length",
    "trailer", "upgrade", "set-cookie",
}


def load_token(args):
    if args.token_file:
        st = os.stat(args.token_file)
        if st.st_mode & 0o077:
            sys.exit(f"error: {args.token_file} must not be readable by others (chmod 0600)")
        with open(args.token_file) as f:
            token = f.read().strip()
    else:
        out = subprocess.run(
            ["security", "find-generic-password", "-s", args.keychain_service,
             "-a", args.keychain_account, "-w"],
            capture_output=True, text=True)
        if out.returncode != 0:
            sys.exit(f"error: no token in the keychain for service {args.keychain_service!r}, "
                     f"account {args.keychain_account!r}")
        token = out.stdout.strip()
    if not token or any(c in token for c in "\r\n"):
        sys.exit("error: the token is empty or malformed")
    return token


class Log:
    def __init__(self, path):
        self.lock = threading.Lock()
        os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
        fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
        self.f = os.fdopen(fd, "a", buffering=1)

    def write(self, **event):
        event["ts"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
        with self.lock:
            self.f.write(json.dumps(event, sort_keys=True) + "\n")


class Capture:
    """A per-session transcript, on the host, out of the VM's reach. One gzip
    member per record (members concatenate, so `gzip -dc` reads them all and a
    crash truncates only the last). The agent cannot reach this file, so it is a
    tamper-evident record. Fail closed: a bad path raises in __init__, before the
    proxy serves; a write error, a record that cannot be built, or the byte
    budget sets `failed`, and the handler then stops the session. A turn's
    request and response records share an `id`."""
    def __init__(self, path, budget):
        self.lock = threading.Lock()
        self.failed = False
        self.fail_reason = None
        self.budget = budget
        self.written = 0
        os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
        self.fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)

    def _fail(self, reason):
        if not self.failed:
            self.failed = True
            self.fail_reason = reason

    def write(self, request=None, response_chunks=None, **record):
        """Append one record. `request` is the client's body; `response_chunks`
        is the relayed response as a list of byte chunks. They are joined,
        decoded and compressed here, inside the try, so a MemoryError or a
        decode error sets `failed` and never reaches the handler. Only the
        budget check and the write hold the lock. Returns False once stopped."""
        try:
            if request is not None:
                record["request"] = request.decode("utf-8", "replace")
            if response_chunks is not None:
                record["response"] = b"".join(response_chunks).decode("utf-8", "replace")
            record["ts"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
            member = gzip.compress(
                (json.dumps(record, ensure_ascii=False, sort_keys=True) + "\n").encode(),
                compresslevel=6)
        except Exception:  # noqa: BLE001  building a record must never reach the handler
            self._fail("the transcript record could not be built")
            return False
        n = len(member)
        with self.lock:
            if self.failed:
                return False
            if self.written + n > self.budget:
                self._fail("the transcript byte budget is exhausted")
                return False
            try:
                while member:
                    member = member[os.write(self.fd, member):]
            except OSError:
                self._fail("the transcript could not be written")
                return False
            self.written += n
        return True


INLINE_SOURCES = {"base64", "text", "content"}

# The API fetches a content block's "source" when its type is not inline
# (base64/text/content), so the policy scans the whole body and refuses a url
# or file source anywhere -- including a new top-level field, which a key
# allowlist would have to list first. These keys instead hold a JSON schema or
# the model's own tool arguments, which the API does not fetch as content, so
# the scan skips them; a schema property named "source" is a field name, not a
# content source. A field the scan does not know still passes, because the
# refusal targets the fetch (a non-inline source), not the field name.
#   input_schema  -- a custom tool's JSON Schema (a parameter can be "source")
#   output_config -- structured-output schema, effort and token budgets
SKIP_SCAN_KEYS = {"input_schema", "output_config"}


def find_remote_source(node, path="body"):
    """Return (path, type) of the first non-inline content source, or None.

    Scans the whole request body. SKIP_SCAN_KEYS and a tool_use block's input
    hold schemas or the model's own arguments, which the API does not fetch, so
    they are not scanned. The path names where a hit is, so a false positive is
    one more SKIP_SCAN_KEYS entry, not a hunt."""
    if isinstance(node, dict):
        src = node.get("source")
        if isinstance(src, dict) and src.get("type") not in INLINE_SOURCES:
            return (f"{path}.source", src.get("type"))
        items = [(f"{path}.{k}", v) for k, v in node.items()
                 if k not in SKIP_SCAN_KEYS
                 and not (k == "input" and str(node.get("type", "")).endswith("tool_use"))]
    elif isinstance(node, list):
        items = [(f"{path}[{i}]", v) for i, v in enumerate(node)]
    else:
        return None
    for child_path, child in items:
        found = find_remote_source(child, child_path)
        if found:
            return found
    return None


def no_duplicate_keys(pairs):
    # A parser that keeps the first of two equal keys would see another
    # document than the one this policy checked. Refuse duplicates.
    keys = [k for k, _ in pairs]
    if len(keys) != len(set(keys)):
        raise ValueError("duplicate key")
    return dict(pairs)


def body_policy(body):
    """Return a denial reason, or None when the body is allowed."""
    try:
        doc = json.loads(body, object_pairs_hook=no_duplicate_keys)
    except RecursionError:
        return "body is nested too deeply"
    except ValueError:
        return "body is not JSON, or has a duplicate key"
    if not isinstance(doc, dict):
        return "body is not a JSON object"
    if "mcp_servers" in doc:
        return "mcp_servers is not allowed (the API would connect to them)"
    if "container" in doc:
        return "container is not allowed (server-side code execution)"
    try:
        remote = find_remote_source(doc)
    except RecursionError:
        return "body is nested too deeply"
    if remote:
        where, kind = remote
        return (f"content source {kind!r} at {where} is not allowed "
                "(only inline sources; the API would fetch a URL)")
    tools = doc.get("tools") or []
    if not isinstance(tools, list):
        return "tools is not a list"
    for tool in tools:
        if not isinstance(tool, dict):
            return "a tool is not an object"
        kind = tool.get("type")
        if kind not in (None, "custom"):
            return f"server tool {kind!r} is not allowed"
    return None


class Handler(socketserver.StreamRequestHandler):
    def deny(self, status, reason, request=None, **log):
        # Every policy refusal is recorded (request records and the id tie it
        # to nothing here, so an id is optional).
        self._capture(id=getattr(self, "rid", None), kind="request", decision="deny",
                      status=status, reason=reason, request=request, **log)
        self.server.log.write(decision="deny", status=status, reason=reason, **log)
        body = json.dumps({"type": "error", "error": {
            "type": "permission_error",
            "message": f"wmf-claude model proxy: {reason}"}}).encode()
        head = (f"HTTP/1.1 {status} Denied\r\nContent-Type: application/json\r\n"
                f"Content-Length: {len(body)}\r\nConnection: close\r\n\r\n")
        try:
            self.wfile.write(head.encode() + body)
            self.responded = True
        except OSError:
            pass

    def _session_stopped(self):
        # The transcript has failed; the session is stopped. Respond, and log
        # the reason once, so this path cannot itself fill the log.
        srv = self.server
        with srv.trip_lock:
            if not srv.trip_logged:
                srv.trip_logged = True
                srv.log.write(decision="deny", status=503,
                              reason=(srv.capture.fail_reason or "the transcript capture failed"))
        body = json.dumps({"type": "error", "error": {"type": "permission_error",
            "message": "wmf-claude model proxy: the session is stopped"}}).encode()
        head = (f"HTTP/1.1 503 Denied\r\nContent-Type: application/json\r\n"
                f"Content-Length: {len(body)}\r\nConnection: close\r\n\r\n")
        try:
            self.wfile.write(head.encode() + body)
            self.responded = True
        except OSError:
            pass

    def _capture(self, request=None, response_chunks=None, **rec):
        """Record one event. request/response are the client's bytes only; the
        outbound headers (with the token) are never passed here. Returns the
        write result (True when there is no transcript), so a caller can refuse
        to forward a request it could not record."""
        cap = self.server.capture
        if cap is None:
            return True
        return cap.write(request=request, response_chunks=response_chunks, **rec)

    def handle(self):
        # Every request ends in a response and a log line, also on a bug.
        self.responded = False
        self.rid = None
        self.connection.settimeout(REQUEST_TIMEOUT)
        try:
            self.handle_request()
        except TimeoutError:
            if not self.responded:
                self.server.log.write(decision="deny", status=408, reason="request not received in time")
        except Exception:  # noqa: BLE001  already responded, or a bug: never a second response
            if not self.responded:
                self.deny(400, "request refused")

    def handle_request(self):
        started = time.monotonic()
        cap = self.server.capture
        if cap is not None and cap.failed:
            return self._session_stopped()
        self.rid = uuid.uuid4().hex
        # Request line and headers, with a hard size limit.
        raw = b""
        while not raw.endswith(b"\r\n\r\n"):
            line = self.rfile.readline(MAX_HEADER_BYTES + 1)
            if not line:
                if raw:
                    # An incomplete connection, not a refused request: log only.
                    self.server.log.write(decision="deny", status=400, reason="connection closed mid-request")
                return
            raw += line
            if len(raw) > MAX_HEADER_BYTES:
                return self.deny(431, "request headers too large")
        lines = raw.decode("latin-1").split("\r\n")
        try:
            method, target, version = lines[0].split(" ")
        except ValueError:
            return self.deny(400, "malformed request line")
        path = target.split("?", 1)[0]
        log = {"method": method, "path": path}
        if version != "HTTP/1.1":
            return self.deny(505, "only HTTP/1.1 is accepted", **log)
        if (method, path) not in ALLOWED:
            return self.deny(403, f"{method} {path} is not allowed", **log)

        headers = []
        content_length = None
        for line in lines[1:]:
            if not line:
                continue
            if ":" not in line or line[0] in " \t":
                return self.deny(400, "malformed header", **log)
            name, value = line.split(":", 1)
            name, value = name.strip(), value.strip()
            lname = name.lower()
            if lname == "transfer-encoding":
                return self.deny(411, "Transfer-Encoding is not accepted; send Content-Length", **log)
            if lname == "content-length":
                if content_length is not None or not (value.isascii() and value.isdigit()):
                    return self.deny(400, "bad Content-Length", **log)
                content_length = int(value)
            elif lname in DROP_HEADERS or lname.startswith("proxy-"):
                continue
            else:
                headers.append((name, value))
        if content_length is None:
            return self.deny(411, "Content-Length is required", **log)
        if content_length > MAX_BODY_BYTES:
            return self.deny(413, "body too large", **log)

        body = self.rfile.read(content_length)
        if len(body) != content_length:
            return self.deny(400, "body shorter than Content-Length", **log)
        reason = body_policy(body)
        if reason:
            cap_req, extra = body, {}
            if len(body) > CAPTURE_DENY_REQ_MAX:
                cap_req = body[:CAPTURE_DENY_REQ_MAX]
                extra = {"request_truncated": True, "request_sha256": hashlib.sha256(body).hexdigest()}
            return self.deny(403, reason, req_bytes=content_length, request=cap_req, **extra, **log)

        # Record the request before it reaches the API, and refuse to forward if
        # it cannot be recorded: the trail is complete, and a capture failure
        # stops the request that fails, not only the next one.
        if not self._capture(id=self.rid, kind="request", decision="request",
                             req_bytes=content_length, request=body, **log):
            return self._session_stopped()

        self.connection.settimeout(None)
        headers.append(("Authorization", f"Bearer {self.server.token}"))
        headers.append(("Content-Length", str(content_length)))
        headers.append(("Accept-Encoding", "identity"))
        conn = http.client.HTTPSConnection(
            UPSTREAM_HOST, 443, timeout=UPSTREAM_TIMEOUT, context=self.server.tls)
        resp_bytes = 0
        status = None
        cap_chunks = []
        cap_bytes = 0
        cap_trunc = False
        try:
            conn.putrequest(method, target, skip_host=False, skip_accept_encoding=True)
            for name, value in headers:
                conn.putheader(name, value)
            conn.endheaders(body)
            resp = conn.getresponse()
            status = resp.status
            out = [f"HTTP/1.1 {resp.status} {resp.reason}\r\n"]
            for name, value in resp.getheaders():
                if name.lower() not in DROP_RESPONSE_HEADERS:
                    out.append(f"{name}: {value}\r\n")
            out.append("Connection: close\r\n\r\n")
            self.wfile.write("".join(out).encode("latin-1"))
            self.responded = True
            # Close-delimited body: relay each chunk as it arrives, and keep a
            # bounded copy for the transcript (the body only, never the headers).
            while True:
                chunk = resp.read1(65536)
                if not chunk:
                    break
                self.wfile.write(chunk)
                self.wfile.flush()
                resp_bytes += len(chunk)
                if cap is not None and not cap_trunc:
                    room = CAPTURE_RESP_MAX - cap_bytes
                    if room <= 0:
                        cap_trunc = True
                    else:
                        cap_chunks.append(chunk[:room])
                        cap_bytes += min(len(chunk), room)
                        cap_trunc = len(chunk) > room
        except ValueError as e:
            # A header value http.client refuses; the request never went out.
            self._capture(id=self.rid, kind="response", decision="error", status=status,
                          reason=str(e), response_chunks=cap_chunks, response_truncated=cap_trunc, **log)
            self.server.log.write(decision="error", reason=str(e), status=status, **log)
            if status is None and not self.responded:
                try:
                    self.wfile.write(b"HTTP/1.1 400 Bad Request\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
                    self.responded = True
                except OSError:
                    pass
            return
        except (OSError, http.client.HTTPException) as e:
            # A client that aborts mid-stream, or an upstream drop. The API had
            # the request already (captured above), so record the partial reply.
            self._capture(id=self.rid, kind="response", decision="error", status=status,
                          reason=str(e), response_chunks=cap_chunks, response_truncated=cap_trunc, **log)
            self.server.log.write(decision="error", reason=str(e), status=status, **log)
            if status is None and not self.responded:
                try:
                    self.wfile.write(b"HTTP/1.1 502 Bad Gateway\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
                    self.responded = True
                except OSError:
                    pass
            return
        finally:
            conn.close()
        self._capture(id=self.rid, kind="response", decision="allow", status=status,
                      resp_bytes=resp_bytes, response_chunks=cap_chunks,
                      response_truncated=cap_trunc, **log)
        self.server.log.write(
            decision="allow", status=status, req_bytes=content_length, resp_bytes=resp_bytes,
            ms=int((time.monotonic() - started) * 1000), **log)


class Server(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
    daemon_threads = True


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--socket", required=True, help="Unix socket to listen on (created 0600)")
    ap.add_argument("--log", required=True, help="JSON-lines request log (appended, 0600)")
    ap.add_argument("--capture", help="per-session transcript of request and response "
                    "bodies, linked by id, one gzip member each (appended, 0600)")
    src = ap.add_mutually_exclusive_group(required=True)
    src.add_argument("--keychain-service", help="macOS keychain service of the token")
    src.add_argument("--token-file", help="file that holds the token (0600)")
    ap.add_argument("--keychain-account", help="macOS keychain account of the token")
    args = ap.parse_args()
    if args.keychain_service and not args.keychain_account:
        ap.error("--keychain-service needs --keychain-account")

    # sockaddr_un holds 104 bytes on macOS (108 on Linux), with the NUL.
    if len(os.fsencode(os.path.abspath(args.socket))) > 103:
        sys.exit(f"error: socket path too long for AF_UNIX: {args.socket}")
    token = load_token(args)
    try:
        budget = int(os.environ.get("WMF_CLAUDE_CAPTURE_MAX_BYTES", CAPTURE_SESSION_MAX_DEFAULT))
    except ValueError:
        sys.exit("error: WMF_CLAUDE_CAPTURE_MAX_BYTES must be an integer")
    # The log and the transcript open, and the first record writes, before the
    # socket binds: a path that cannot be opened or written must exit before the
    # launcher can see a live socket.
    log = Log(args.log)
    try:
        capture = Capture(args.capture, budget) if args.capture else None
    except OSError as e:
        sys.exit(f"error: cannot open the transcript file {args.capture}: {e}")
    if capture is not None and not capture.write(kind="start", pid=os.getpid()):
        sys.exit(f"error: cannot write the transcript file {args.capture}: {capture.fail_reason}")
    sock_dir = os.path.dirname(os.path.abspath(args.socket))
    os.makedirs(sock_dir, mode=0o700, exist_ok=True)
    if os.path.lexists(args.socket):
        if not stat.S_ISSOCK(os.lstat(args.socket).st_mode):
            sys.exit(f"error: {args.socket} exists and is not a socket")
        os.unlink(args.socket)
    old = os.umask(0o177)
    try:
        server = Server(args.socket, Handler)
    finally:
        os.umask(old)
    server.token = token
    server.log = log
    server.capture = capture
    server.trip_lock = threading.Lock()
    server.trip_logged = False
    server.tls = tls_context()
    # SIGTERM (bin/claude-vm stops the proxy with it) exits through the
    # finally below, which removes the socket.
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    server.log.write(decision="start", socket=args.socket, pid=os.getpid())
    print(f"wmf-claude model proxy on {args.socket}, log {args.log}", file=sys.stderr, flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.log.write(decision="stop", pid=os.getpid())
        try:
            os.unlink(args.socket)
        except OSError:
            pass


def tls_context():
    """A verifying TLS context. A python.org build on macOS has no CA
    certificates until its 'Install Certificates' step runs, so add the
    macOS system bundle when it is there."""
    ctx = ssl.create_default_context()
    if os.path.exists("/etc/ssl/cert.pem"):
        ctx.load_verify_locations("/etc/ssl/cert.pem")
    return ctx


if __name__ == "__main__":
    main()
