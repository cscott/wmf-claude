{
  "meta": {
    "name": "wmf-contained",
    "version": "0.1.0",
    "description": "Claude Code in a contained Lima VM: no egress of its own. The model API is reached only through the host-side proxy that bin/wmf-claude-vm forwards to a localhost port; the token stays on the host.",
    "author": "Kosta Harlan <kharlan@wikimedia.org>"
  },
  "extends": "claude-code",
  "security": {
    "signal_mode": "isolated",
    "process_info_mode": "isolated",
    "ipc_mode": "shared_memory_only",
    "capability_elevation": false
  },
  "workdir": {
    "access": "readwrite"
  },
  "environment": {
    "allow_vars": [
      "PATH",
      "HOME",
      "TERM",
      "LANG",
      "LC_*",
      "CLAUDE_*",
      "CLAUDECODE",
      "ANTHROPIC_*",
      "NONO_*",
      "WMF_DOCKER_*",
      "WMF_CLAUDE_*"
    ]
  },
  "filesystem": {
    "allow": [
      "$WORKDIR"
    ],
    "read": [
      "~/.local/state/fnm_multishells",
      "~/.local/state/claude/locks",
      "~/.agents/skills"
    ],
    "deny": [
      "~/.ssh",
      "~/.env",
      "~/.bashrc",
      "~/.bash_profile",
      "~/.bash_history",
      "~/.zshrc",
      "~/.zprofile",
      "~/.zsh_history",
      "~/.config/fish/config.fish",
      "~/.config/fish/fish_variables",
      "~/.profile",
      "~/.netrc",
      "~/.npmrc",
      "~/.pypirc",
      "~/.composer/auth.json",
      "~/.config/composer/auth.json",
      "~/.docker/config.json",
      "~/.kube/config",
      "~/.aws",
      "~/.config/gcloud",
      "~/.gnupg",
      "~/.config/gh",
      "~/.password-store",
      "~/.config/bitwarden",
      "~/.config/keepassxc",
      "~/Library/Application Support/1Password",
      "~/Library/Application Support/Bitwarden",
      "~/Library/Application Support/Enpass",
      "~/Library/Mail",
      "~/Library/Messages",
      "~/Library/Application Support/Slack",
      "~/Library/Application Support/Discord",
      "~/Library/Application Support/Signal",
      "~/Library/Application Support/Telegram",
      "~/.thunderbird",
      "~/Library/Mobile Documents",
      "~/Library/Application Support/Chromium",
      "~/Library/Application Support/BraveSoftware",
      "~/Library/Application Support/Vivaldi",
      "~/Library/Application Support/com.operasoftware.Opera",
      "~/.git-credentials",
      "~/.config/git/credentials",
      "~/.vault-token",
      "~/.terraform.d",
      "~/.azure",
      "~/.config/op",
      "~/.cargo/credentials.toml",
      "~/.cargo/credentials",
      "~/.gem/credentials",
      "~/.local/share/keyrings",
      "~/.config/hub",
      "~/.gitcookies",
      "~/.config/glab-cli",
      "~/.config/wmf-claude"
    ],
    "suppress_save_prompt": [
      "/"
    ]
  },
  "unsafe_macos_seatbelt_rules": [
    "(deny mach-lookup (global-name-prefix \"com.apple.metadata.\"))"
  ],
  "network": {
    "allow_domain": [
      "deny-all.invalid"
    ]
  }
}
