      { "domain": "*.wikinews.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "*.wikiversity.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "*.wikifunctions.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "docs.python.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "docs.rs", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "doc.rust-lang.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "developer.mozilla.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "nodejs.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "pkg.go.dev", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "www.php.net", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "php.net", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "vuejs.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "*.vuejs.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "codesearch.wmcloud.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "codesearch-backend.wmcloud.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      "*.local.wmftest.net"
    ]
  },
  "workdir": { "access": "readwrite" },
  "unsafe_macos_seatbelt_rules": [
    "(deny mach-lookup (global-name-prefix \"com.apple.metadata.\"))"
  ]
}
