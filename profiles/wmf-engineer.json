{
  "extends": "claude-code",
  "meta": {
    "name": "wmf-engineer",
    "version": "0.6.0",
    "description": "Wikimedia Foundation engineer profile for Claude Code with WMF-specific domain access and destructive action prevention",
    "author": "Kosta Harlan <kharlan@wikimedia.org>"
  },
  "security": {
    "signal_mode": "isolated",
    "process_info_mode": "isolated",
    "ipc_mode": "shared_memory_only",
    "capability_elevation": false
  },
  "filesystem": {
    "allow": [
      "$WORKDIR"
    ],
    "read": [
      "~/.local/state/fnm_multishells",
      "~/.local/state/claude/locks",
      "~/.agents/skills"
    ],
    "deny": [
      "~/.ssh",
      "~/.env",
      "~/.bashrc",
      "~/.bash_profile",
      "~/.bash_history",
      "~/.zshrc",
      "~/.zprofile",
      "~/.zsh_history",
      "~/.config/fish/config.fish",
      "~/.config/fish/fish_variables",
      "~/.profile",
      "~/.netrc",
      "~/.npmrc",
      "~/.pypirc",
      "~/.composer/auth.json",
      "~/.config/composer/auth.json",
      "~/.docker/config.json",
      "~/.kube/config",
      "~/.aws",
      "~/.config/gcloud",
      "~/.gnupg",
      "~/.config/gh",
      "~/.password-store",
      "~/.config/bitwarden",
      "~/.config/keepassxc",
      "~/Library/Application Support/1Password",
      "~/Library/Application Support/Bitwarden",
      "~/Library/Application Support/Enpass",
      "~/Library/Mail",
      "~/Library/Messages",
      "~/Library/Application Support/Slack",
      "~/Library/Application Support/Discord",
      "~/Library/Application Support/Signal",
      "~/Library/Application Support/Telegram",
      "~/.thunderbird",
      "~/Library/Mobile Documents",
      "~/Library/Application Support/Chromium",
      "~/Library/Application Support/BraveSoftware",
      "~/Library/Application Support/Vivaldi",
      "~/Library/Application Support/com.operasoftware.Opera",
      "~/.git-credentials",
      "~/.config/git/credentials",
      "~/.vault-token",
      "~/.terraform.d",
      "~/.azure",
      "~/.config/op",
      "~/.cargo/credentials.toml",
      "~/.cargo/credentials",
      "~/.gem/credentials",
      "~/.local/share/keyrings",
      "~/.config/hub",
      "~/.gitcookies",
      "~/.config/glab-cli"
    ],
    "suppress_save_prompt": [
      "~/.ssh",
      "~/.env",
      "~/.bashrc",
      "~/.bash_profile",
      "~/.bash_history",
      "~/.zshrc",
      "~/.zprofile",
      "~/.zsh_history",
      "~/.config/fish/config.fish",
      "~/.config/fish/fish_variables",
      "~/.profile",
      "~/.netrc",
      "~/.npmrc",
      "~/.pypirc",
      "~/.composer/auth.json",
      "~/.config/composer/auth.json",
      "~/.docker/config.json",
      "~/.kube/config",
      "~/.aws",
      "~/.config/gcloud",
      "~/.gnupg",
      "~/.config/gh",
      "~/.password-store",
      "~/.config/bitwarden",
      "~/.config/keepassxc",
      "~/Library/Application Support/1Password",
      "~/Library/Application Support/Bitwarden",
      "~/Library/Application Support/Enpass",
      "~/Library/Mail",
      "~/Library/Messages",
      "~/Library/Application Support/Slack",
      "~/Library/Application Support/Discord",
      "~/Library/Application Support/Signal",
      "~/Library/Application Support/Telegram",
      "~/.thunderbird",
      "~/Library/Mobile Documents",
      "~/Library/Application Support/Google/Chrome",
      "~/Library/Application Support/Google/Chrome Beta",
      "~/Library/Application Support/Google/Chrome Canary",
      "~/Library/Application Support/Chromium",
      "~/Library/Application Support/Microsoft Edge",
      "~/Library/Application Support/BraveSoftware",
      "~/Library/Application Support/Arc",
      "~/Library/Application Support/Vivaldi",
      "~/Library/Application Support/com.operasoftware.Opera",
      "/home",
      "~",
      "~/.local/state/claude/locks",
      "~/.CFUserTextEncoding",
      "~/.git-credentials",
      "~/.config/git/credentials",
      "~/.vault-token",
      "~/.terraform.d",
      "~/.azure",
      "~/.config/op",
      "~/.cargo/credentials.toml",
      "~/.cargo/credentials",
      "~/.gem/credentials",
      "~/.local/share/keyrings",
      "~/.config/hub",
      "~/.gitcookies",
      "~/.config/glab-cli"
    ]
  },
  "environment": {
    "allow_vars": [
      "PATH", "HOME",
      "TERM",
      "LANG", "LC_*",
      "CLAUDE_*", "CLAUDECODE", "ANTHROPIC_*",
      "NONO_*",
      "WMF_DOCKER_*", "WMF_CLAUDE_*",
      "PHABRICATOR_URL", "PHABRICATOR_USERNAME",
      "PHABRICATOR_CONTACT_NAME", "PHABRICATOR_CONTACT_EMAIL",
      "GERRIT_BASE_URL", "GERRIT_CONFIG_PATH"
    ]
  },
  "network": {
    "block": false,
    "allow_domain": [
      "api.anthropic.com",
      "claude.ai",
      "platform.claude.com",
      "*.claudeusercontent.com",
      "gerrit.wikimedia.org",
      { "domain": "phabricator.wikimedia.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" }, { "method": "POST", "path": "/search" } ] },
      { "domain": "gitlab.wikimedia.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" }, { "method": "POST", "path": "/**/git-upload-pack" } ] },
      { "domain": "commons.wikimedia.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "meta.wikimedia.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "species.wikimedia.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "incubator.wikimedia.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "wikitech.wikimedia.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "outreach.wikimedia.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "wikimania.wikimedia.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "api.wikimedia.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "doc.wikimedia.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "integration.wikimedia.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "upload.wikimedia.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "noc.wikimedia.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "releases.wikimedia.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "dumps.wikimedia.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "design.wikimedia.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "test-commons.wikimedia.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "lists.wikimedia.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "stream.wikimedia.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "people.wikimedia.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "analytics.wikimedia.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "stats.wikimedia.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "www.wikimedia.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "*.wikipedia.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "*.mediawiki.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "*.wikidata.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "*.wiktionary.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "*.wikibooks.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
