{
  "extends": "claude-code",
  "meta": {
    "name": "wmf-engineer",
    "version": "0.4.0",
    "description": "Wikimedia Foundation engineer profile for Claude Code with WMF-specific domain access and destructive action prevention",
    "author": "Kosta Harlan <kharlan@wikimedia.org>"
  },
  "security": {
    "signal_mode": "isolated",
    "process_info_mode": "isolated",
    "ipc_mode": "shared_memory_only",
    "capability_elevation": false
  },
  "filesystem": {
    "allow": [
      "$WORKDIR"
    ],
    "read": [
      "~/.local/state/fnm_multishells",
      "~/.local/state/claude/locks",
      "~/.agents/skills"
    ],
    "deny": [
      "~/.ssh",
      "~/.env",
      "~/.bashrc",
      "~/.bash_profile",
      "~/.bash_history",
      "~/.zshrc",
      "~/.zprofile",
      "~/.zsh_history",
      "~/.config/fish/config.fish",
      "~/.config/fish/fish_variables",
      "~/.profile",
      "~/.netrc",
      "~/.npmrc",
      "~/.pypirc",
      "~/.composer/auth.json",
      "~/.config/composer/auth.json",
      "~/.docker/config.json",
      "~/.kube/config",
      "~/.aws",
      "~/.config/gcloud",
      "~/.gnupg",
      "~/.config/gh",
      "~/.password-store",
      "~/.config/bitwarden",
      "~/.config/keepassxc",
      "~/Library/Application Support/1Password",
      "~/Library/Application Support/Bitwarden",
      "~/Library/Application Support/Enpass",
      "~/Library/Mail",
      "~/Library/Messages",
      "~/Library/Application Support/Slack",
      "~/Library/Application Support/Discord",
      "~/Library/Application Support/Signal",
      "~/Library/Application Support/Telegram",
      "~/.thunderbird",
      "~/Library/Mobile Documents",
      "~/Library/Application Support/Chromium",
      "~/Library/Application Support/BraveSoftware",
      "~/Library/Application Support/Vivaldi",
      "~/Library/Application Support/com.operasoftware.Opera"
    ],
    "suppress_save_prompt": [
      "~/.ssh",
      "~/.env",
      "~/.bashrc",
      "~/.bash_profile",
      "~/.bash_history",
      "~/.zshrc",
      "~/.zprofile",
      "~/.zsh_history",
      "~/.config/fish/config.fish",
      "~/.config/fish/fish_variables",
      "~/.profile",
      "~/.netrc",
      "~/.npmrc",
      "~/.pypirc",
      "~/.composer/auth.json",
      "~/.config/composer/auth.json",
      "~/.docker/config.json",
      "~/.kube/config",
      "~/.aws",
      "~/.config/gcloud",
      "~/.gnupg",
      "~/.config/gh",
      "~/.password-store",
      "~/.config/bitwarden",
      "~/.config/keepassxc",
      "~/Library/Application Support/1Password",
      "~/Library/Application Support/Bitwarden",
      "~/Library/Application Support/Enpass",
      "~/Library/Mail",
      "~/Library/Messages",
      "~/Library/Application Support/Slack",
      "~/Library/Application Support/Discord",
      "~/Library/Application Support/Signal",
      "~/Library/Application Support/Telegram",
      "~/.thunderbird",
      "~/Library/Mobile Documents",
      "~/Library/Application Support/Google/Chrome",
      "~/Library/Application Support/Google/Chrome Beta",
      "~/Library/Application Support/Google/Chrome Canary",
      "~/Library/Application Support/Chromium",
      "~/Library/Application Support/Microsoft Edge",
      "~/Library/Application Support/BraveSoftware",
      "~/Library/Application Support/Arc",
      "~/Library/Application Support/Vivaldi",
      "~/Library/Application Support/com.operasoftware.Opera",
      "/home",
      "~",
      "~/.local/state/claude/locks",
      "~/.CFUserTextEncoding"
    ]
  },
  "environment": {
    "allow_vars": [
      "PATH", "HOME",
      "TERM",
      "LANG", "LC_*",
      "CLAUDE_*", "CLAUDECODE", "ANTHROPIC_*",
      "NONO_*",
      "WMF_DOCKER_*",
      "PHABRICATOR_URL", "PHABRICATOR_USERNAME",
      "PHABRICATOR_CONTACT_NAME", "PHABRICATOR_CONTACT_EMAIL",
      "GERRIT_BASE_URL", "GERRIT_CONFIG_PATH"
    ]
  },
  "network": {
    "block": false,
    "network_profile": "minimal",
    "allow_domain": [
      "api.anthropic.com",
      "claude.ai",
      "platform.claude.com",
      "*.wikimedia.org",
      "*.wikipedia.org",
      "*.mediawiki.org",
      "*.wikidata.org",
      "*.wiktionary.org",
      { "domain": "docs.python.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "docs.rs", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "doc.rust-lang.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "developer.mozilla.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "nodejs.org", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "pkg.go.dev", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "www.php.net", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      { "domain": "php.net", "endpoints": [ { "method": "GET", "path": "/**" }, { "method": "HEAD", "path": "/**" } ] },
      "*.wikibooks.org",
      "*.wikiquote.org",
      "*.wikivoyage.org",
      "*.wikisource.org",
      "*.wikinews.org",
      "*.wikiversity.org",
      "*.wikifunctions.org",
      "codesearch.wmcloud.org",
      "codesearch-backend.wmcloud.org",
      "api.minimax.io"
    ],
    "open_port": [3306]
  },
  "workdir": { "access": "readwrite" },
  "unsafe_macos_seatbelt_rules": [
    "(deny mach-lookup (global-name-prefix \"com.apple.metadata.\"))"
  ]
}
