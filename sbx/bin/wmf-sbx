#!/usr/bin/env bash
# wmf-sbx: MediaWiki development sandboxes in Lima VMs.
#
# A plain dispatcher: `wmf-sbx VERB ARGS...` runs the wmf-sbx-VERB script
# next to this file. There is no Docker sbx any more
# (lima-port/HANDOFF-LIMA.md §4; the sbx-docker-final branch keeps the
# Docker backend). Every verb that acts on a sandbox requires its state
# file, so wmf-sbx never touches a Lima VM it did not make.
#
#   wmf-sbx create PRIMARY [EXTRA...]   make a sandbox (a Lima VM)
#   wmf-sbx start|stop|status NAME      boot, stop, check
#   wmf-sbx exec NAME -- CMD...         run a command as the agent
#   wmf-sbx cp SRC DST                  copy; one side is NAME:PATH
#   wmf-sbx rm NAME                     remove the VM, state and remotes
#   wmf-sbx ls                          list the sandboxes
#   wmf-sbx image build|ls|rm|prune     the golden image
#   wmf-sbx resolve | ls-remotes        repo resolution, host remotes
set -euo pipefail
# Kept from the Docker backend: an SSH agent socket has no business in
# any command this starts.
unset SSH_AUTH_SOCK

VERBS="cp create exec image ls ls-remotes resolve rm start status stop"
NOT_YET="resume run"
RETIRED="refresh-claude-md settings ports policy kit secret"

usage() {
  sed -n '2,/^set -euo/{/^set -euo/d;s/^# \{0,1\}//;p;}' "${BASH_SOURCE[0]}"
}

verb="${1:-}"
case " $VERBS " in
  *" $verb "*)
    shift
    # realpath: this script is often reached through a symlink, and the
    # wmf-sbx-VERB scripts are next to the real file (sbx/NOTES.md §66).
    self=$(readlink -f -- "${BASH_SOURCE[0]}")
    sibling="$(dirname -- "$self")/wmf-sbx-$verb"
    if [ ! -x "$sibling" ]; then
      sibling=$(command -v "wmf-sbx-$verb") || {
        echo "wmf-sbx: can't find 'wmf-sbx-$verb' next to this script or on PATH;" \
             "is the install incomplete?" >&2
        exit 1
      }
    fi
    exec "$sibling" "$@"
    ;;
esac

case " $NOT_YET " in
  *" $verb "*)
    echo "wmf-sbx: '$verb' is not ported to Lima yet (lima-port/HANDOFF-LIMA.md" \
         "§11, phase 6). Use 'wmf-sbx exec NAME -- CMD' for now." >&2
    exit 1
    ;;
esac
case " $RETIRED " in
  *" $verb "*)
    echo "wmf-sbx: '$verb' belonged to the Docker sbx backend and is retired." >&2
    exit 1
    ;;
esac

if [ -z "$verb" ] || [ "$verb" = "-h" ] || [ "$verb" = "--help" ] || [ "$verb" = "help" ]; then
  usage
  [ -n "$verb" ]
  exit $?
fi
echo "wmf-sbx: unknown verb '$verb'. Verbs: $VERBS" >&2
exit 1
