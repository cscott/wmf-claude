#!/usr/bin/env bash
# wmf-sbx-gateway-tools: list the tools the sbx MCP gateway serves to *this*
# sandbox. Runs INSIDE a sandbox (unlike the other wmf-sbx-* tools, which are
# host-side); it needs nothing but curl and jq, both in the sbx base image.
#
# Why this exists: the gateway is one Claude Code MCP entry named
# `mcp-gateway`, so every tool it serves reaches the model as
# `mcp__mcp-gateway__<name>`. Whether <name> is a meta-tool (`mcp-exec`) or a
# real tool (`phabricator_get_task`) depends on how the sandbox was launched --
# dynamic discovery vs `--static-mcp`. `claude mcp list` does not show it; it
# only says the gateway is connected. So ask the gateway itself.
#
#   wmf-sbx-gateway-tools            # names and one-line descriptions
#   wmf-sbx-gateway-tools --json     # the raw tools array
#
# See sbx/DESIGN-plugin-integration.md §4 (Route 1) and sbx/NOTES.md §57.
set -uo pipefail

GW="${MCP_GATEWAY_URL:-http://mcp-gateway.docker.internal/mcp}"
AUTH="${MCP_GATEWAY_AUTH:-Bearer proxy-managed}"
HDRS=(-H "Authorization: $AUTH" -H 'Content-Type: application/json'
      -H 'Accept: application/json, text/event-stream')

die() { echo "wmf-sbx-gateway-tools: $*" >&2; exit 1; }

for tool in curl jq; do
  command -v "$tool" >/dev/null || die "need $tool on PATH"
done

hdr=$(mktemp) || die "mktemp failed"
trap 'rm -f "$hdr"' EXIT

# The gateway speaks streamable HTTP: replies arrive as SSE frames, and
# `tools/list` is rejected until the initialize handshake has completed and
# the session id from the response header is echoed back on every later call.
curl -sS -D "$hdr" -X POST "$GW" "${HDRS[@]}" -o /dev/null \
  -d '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"wmf-sbx-gateway-tools","version":"1"}}}' \
  || die "cannot reach the gateway at $GW"

sid=$(grep -i '^mcp-session-id:' "$hdr" | cut -d' ' -f2 | tr -d '\r')
[ -n "$sid" ] || die "gateway returned no Mcp-Session-Id (is this an sbx sandbox?)"

gw_post() {
  curl -sS -X POST "$GW" "${HDRS[@]}" -H "Mcp-Session-Id: $sid" -d "$1" \
    | sed -n 's/^data: //p'
}

gw_post '{"jsonrpc":"2.0","method":"notifications/initialized"}' >/dev/null
reply=$(gw_post '{"jsonrpc":"2.0","id":2,"method":"tools/list","params":{}}')

err=$(jq -r '.error.message // empty' <<<"$reply" 2>/dev/null)
[ -z "$err" ] || die "gateway said: $err"

if [ "${1:-}" = "--json" ]; then
  jq '.result.tools' <<<"$reply"
  exit 0
fi

count=$(jq -r '.result.tools | length' <<<"$reply")
echo "gateway: $count tool(s) at $GW"
echo "(the model sees each of these as mcp__mcp-gateway__<name>)"
jq -r '.result.tools[] | "  \(.name)\n      \(.description // "" | split("\n")[0][0:100])"' <<<"$reply"
[ "$count" -gt 0 ] || echo "  (none -- no servers are mounted into this sandbox's session)"
