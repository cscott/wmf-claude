#!/usr/bin/env python3
"""wmf-sbx-mcp-proxy: expose ONE gateway-hosted MCP server to Claude Code
under its own name, so the tools keep the names `skills/` already use.

Runs INSIDE a sandbox (like wmf-sbx-gateway-tools, unlike every other
wmf-sbx-* script). Stdlib only -- no pip install, nothing to vendor.

    claude mcp add --scope user phabricator -- \
        wmf-sbx-mcp-proxy phabricator --tools phabricator_get_task,...

Why this exists
---------------
sbx runs host-side MCP servers behind one gateway, which reaches the
sandbox as a single Claude Code config entry named `mcp-gateway`. Claude
derives a tool's name from the *entry* name, so everything the gateway
serves arrives as `mcp__mcp-gateway__<tool>` -- and in the gateway's
default dynamic mode `<tool>` is one of five meta-tools, with a real
tool reached by calling `mcp-exec`. Our skills, the `gerrit-reviewer`
agent and `bin/session-start.sh` name tools literally
(`mcp__phabricator__phabricator_get_task`,
`mcp__gerrit__get_commit_message`), and not forking `skills/` is a
standing non-goal.

This proxy is a stdio MCP server named after the host-side server it
fronts. It speaks JSON-RPC on stdin/stdout to Claude Code and streamable
HTTP to the gateway, forwarding `tools/list` and `tools/call` unchanged.
The names therefore come out `mcp__<server>__<tool>`, the credentials
stay on the host with the real server (nothing secret enters the
sandbox), and the gateway's audit trail still sees every call.

It also narrows what the model can reach. The gateway's own meta-tools
let an agent add MCP servers to its session (`mcp-add`) and run
JavaScript (`code-mode`); deny `mcp__mcp-gateway` in `settings.json` and
the model sees only what this proxy advertises -- an explicit allowlist
when `--tools` is given. Denying the server does not stop the proxy: the
deny applies to Claude's tool layer, not to our own HTTP calls.

Which tools are ours: `--tools` is required
-------------------------------------------
The gateway serves every mounted server's tools in ONE FLAT NAMESPACE
with no attribution: no `_meta`, no annotations, `mcp-find` returns
server names only, and `mcp-add` answers with a count rather than names
(MEASURED, NOTES.md §62.2). So "everything the gateway serves" cannot be
the default -- with both our servers mounted it would answer to
`mcp__gerrit__phabricator_get_task`. `--tools` is therefore mandatory,
and doubles as the policy statement of what this sandbox may reach.

There *is* one moment attribution is observable -- the names that appear
across an `mcp-add` -- and we use it, but only as a cross-check that
warns and drops an allowlisted tool this server does not serve. It is not
a discovery mechanism: mounts are sandbox-wide and outlive the gateway
session (MEASURED, §62.3), so the diff is empty on every start after the
first and an auto-discovering proxy would work once and then serve
nothing.

Usage
-----
    wmf-sbx-mcp-proxy <server> [--tools a,b,c] [--no-add] [--url URL]

    <server>     the name the server was registered under on the host
                 (`sbx mcp add <server> ...`)
    --tools      comma-separated allowlist of tool names. REQUIRED: the
                 gateway's tool namespace is flat and unattributed, so
                 this is the only thing that says which tools are this
                 server's -- see below.
    --no-add     do not try `mcp-add` (the server is already mounted,
                 e.g. `sbx create --static-mcp <server>`)
    --url        gateway URL (default $MCP_GATEWAY_URL, else the
                 well-known http://mcp-gateway.docker.internal/mcp)

Env: MCP_GATEWAY_URL, MCP_GATEWAY_AUTH (default `Bearer proxy-managed`,
which is the sentinel the sandbox proxy swaps for the real credential).

See sbx/DESIGN-plugin-integration.md §4 (Route 1) and sbx/NOTES.md §60.
"""

import argparse
import json
import os
import sys
import urllib.error
import urllib.request

DEFAULT_URL = "http://mcp-gateway.docker.internal/mcp"
DEFAULT_AUTH = "Bearer proxy-managed"
PROTOCOL_VERSION = "2025-06-18"

# The gateway's own tools, which front no host-side server and must never
# be re-exported under a server's name (NOTES.md §57.2).
META_TOOLS = frozenset(
    {"mcp-find", "mcp-add", "mcp-config-set", "mcp-exec", "code-mode"}
)


def log(msg):
    print("wmf-sbx-mcp-proxy: %s" % msg, file=sys.stderr, flush=True)


class GatewayError(Exception):
    pass


class GatewaySessionLost(GatewayError):
    """The gateway no longer knows the session id we are echoing.

    Streamable HTTP says a server that has dropped a session answers with
    404 (MCP spec, "Session Management"), and that the client's move is to
    start a new session with a fresh `initialize`. We only raise this when
    we actually *sent* a session id -- a 404 before the handshake is a
    wrong URL, not an expiry.
    """


class Gateway:
    """One streamable-HTTP session with the sbx MCP gateway.

    `tools/list` is refused until the initialize handshake completes and
    the `Mcp-Session-Id` response header is echoed back on every later
    call, so the session id is not optional bookkeeping.
    """

    def __init__(self, url, auth, timeout=60):
        self.url = url
        self.auth = auth
        self.timeout = timeout
        self.session_id = None
        self.server_info = {}
        self.protocol_version = PROTOCOL_VERSION
        self.reconnects = 0
        self.on_reconnect = []
        self._reconnecting = False
        self._next_id = 1000

    def _post(self, payload, want_reply=True):
        body = json.dumps(payload).encode()
        headers = {
            "Authorization": self.auth,
            "Content-Type": "application/json",
            "Accept": "application/json, text/event-stream",
        }
        if self.session_id:
            headers["Mcp-Session-Id"] = self.session_id
        req = urllib.request.Request(self.url, data=body, headers=headers)
        try:
            with urllib.request.urlopen(req, timeout=self.timeout) as resp:
                if self.session_id is None:
                    self.session_id = resp.headers.get("Mcp-Session-Id")
                raw = resp.read().decode("utf-8", "replace")
        except urllib.error.HTTPError as exc:
            detail = exc.read().decode("utf-8", "replace")[:200]
            if exc.code == 404 and self.session_id:
                raise GatewaySessionLost(
                    "the gateway dropped MCP session %s (HTTP 404: %s). This is a "
                    "gateway-side session expiry, not an authentication failure: "
                    "the host-side server's credentials never reach this sandbox "
                    "and are not involved." % (self.session_id, detail)
                )
            raise GatewayError("HTTP %s from gateway: %s" % (exc.code, detail))
        except OSError as exc:
            raise GatewayError("cannot reach gateway at %s: %s" % (self.url, exc))
        if not want_reply:
            return None
        return self._parse(raw)

    @staticmethod
    def _parse(raw):
        """Pull the JSON-RPC message out of a plain or SSE-framed body."""
        payloads = []
        for line in raw.splitlines():
            if line.startswith("data:"):
                payloads.append(line[5:].strip())
        if not payloads:
            stripped = raw.strip()
            if not stripped:
                return None
            payloads = [stripped]
        for text in reversed(payloads):
            try:
                return json.loads(text)
            except ValueError:
                continue
        raise GatewayError("unparseable gateway reply: %r" % raw[:200])

    def call(self, method, params=None, retry=True):
        self._next_id += 1
        payload = {"jsonrpc": "2.0", "id": self._next_id, "method": method}
        if params is not None:
            payload["params"] = params
        try:
            reply = self._post(payload)
        except GatewaySessionLost:
            # `initialize` is how we recover, so it can never be the thing
            # we recover *from*; one retry, never a loop; and calls made
            # *by* the recovery (the re-mount) do not get to recurse into
            # it.
            if not retry or method == "initialize" or self._reconnecting:
                raise
            log("gateway dropped our session; re-running the handshake")
            self.reconnect()
            return self.call(method, params, retry=False)
        if reply is None:
            raise GatewayError("empty reply to %s" % method)
        if "error" in reply:
            raise GatewayError(
                "%s: %s" % (method, reply["error"].get("message", reply["error"]))
            )
        return reply.get("result", {})

    def notify(self, method, params=None):
        payload = {"jsonrpc": "2.0", "method": method}
        if params is not None:
            payload["params"] = params
        self._post(payload, want_reply=False)

    def connect(self):
        result = self.call(
            "initialize",
            {
                "protocolVersion": PROTOCOL_VERSION,
                "capabilities": {},
                "clientInfo": {"name": "wmf-sbx-mcp-proxy", "version": "1"},
            },
        )
        if not self.session_id:
            raise GatewayError(
                "gateway returned no Mcp-Session-Id (is this an sbx sandbox?)"
            )
        self.server_info = result.get("serverInfo", {})
        self.protocol_version = result.get("protocolVersion", PROTOCOL_VERSION)
        self.notify("notifications/initialized")

    def reconnect(self):
        """Throw away the dead session id and handshake again.

        Clearing `session_id` first matters twice: `_post` only adopts a
        new id when it has none, and it only reads a 404 as an expiry when
        it sent one -- so a failing re-handshake surfaces as itself rather
        than as another expiry.
        """
        self.session_id = None
        self._reconnecting = True
        try:
            self.connect()
            self.reconnects += 1
            for hook in self.on_reconnect:
                hook()
        finally:
            self._reconnecting = False

    def list_tools(self, cursor=None):
        params = {} if cursor is None else {"cursor": cursor}
        result = self.call("tools/list", params)
        return result.get("tools", []), result.get("nextCursor")


class Proxy:
    def __init__(self, server, gateway, allowlist=None, try_add=True):
        self.server = server
        self.gw = gateway
        self.allowlist = allowlist
        self.try_add = try_add
        self.connected = False
        self.added = False
        self.discovered = None  # names attributed to us by the mcp-add diff
        self.exposed = set()
        gateway.on_reconnect.append(self._gateway_reconnected)

    # -- gateway side ----------------------------------------------------

    def _gateway_reconnected(self):
        """A session we were using expired and has been replaced.

        This is the common path, not the exceptional one: the gateway's
        idle timeout is 45 seconds (MEASURED, §74), which is shorter than
        the gap between Claude Code spawning us and the model's first
        tool call, so most calls arrive on a dead session. It stays cheap
        because mounts outlive sessions (§62.3) and static mode does not
        re-mount at all -- the whole recovery is ~2 ms (§74.2), against a
        tool call that then goes out over the network.

        A gateway that *restarted*, though, dropped the mount with the
        session, and then the retried `tools/call` would fail on a tool
        the gateway no longer serves. So re-run the mount-and-list here,
        before the retry, rather than leaving it to the next `tools/list`
        that may never come.
        """
        self.added = False
        self.discovered = None
        try:
            self.visible_tools()
        except GatewayError as exc:
            log("could not re-list tools after reconnect: %s" % exc)

    def ensure_connected(self):
        if self.connected:
            return
        self.gw.connect()
        self.connected = True
        log(
            "gateway session up (%s)"
            % (self.gw.server_info.get("name", "unknown server"))
        )

    def _mcp_add(self, tool_names):
        """Mount our server into this gateway session (dynamic mode).

        Static mode (`sbx create --static-mcp`) mounts it already and
        serves no `mcp-add`, so a miss here is not an error.
        """
        if self.added or not self.try_add or "mcp-add" not in tool_names:
            return False
        try:
            self.gw.call(
                "tools/call", {"name": "mcp-add", "arguments": {"name": self.server}}
            )
        except GatewayError as exc:
            log("mcp-add %s failed: %s" % (self.server, exc))
            self.added = True  # do not retry on every tools/list
            return False
        self.added = True
        log("mcp-add %s ok" % self.server)
        return True

    def _drain(self, tools, cursor):
        pages = 0
        while cursor and pages < 20:
            more, cursor = self.gw.list_tools(cursor)
            tools.extend(more)
            pages += 1
        return tools

    def gateway_tools(self):
        """Every tool the gateway serves us, meta-tools included.

        The gateway's `tools/list` is one flat namespace with no hint of
        which server a tool came from (MEASURED, NOTES.md §62.2: no
        `_meta`, no annotations, and `mcp-find` returns only names). The
        one moment attribution is observable is `mcp-add`: whatever
        appears between the before and after listings is ours. Only on a
        server's *first* mount, though -- mounts are sandbox-wide and
        outlive the session (§62.3) -- so this cross-checks `--tools`
        rather than replacing it.
        """
        tools = self._drain(*self.gw.list_tools())
        before = {t.get("name") for t in tools}
        if self._mcp_add(before):
            tools = self._drain(*self.gw.list_tools())
            new = {t.get("name") for t in tools} - before
            if new:
                self.discovered = frozenset(new)
                log(
                    "%s serves %d tool(s): %s"
                    % (self.server, len(new), ", ".join(sorted(new)))
                )
            else:
                log("mcp-add %s added no tools (already mounted?)" % self.server)
        return tools

    def visible_tools(self):
        """The gateway's tools, less meta-tools, less anything that is not
        this server's.

        Two proxies can share one gateway that serves both their servers,
        and the flat namespace means "everything the gateway serves" would
        re-export the *other* server's tools under our name. So expose
        exactly `--tools`, minus anything the `mcp-add` diff says is not
        ours, and **fail closed** if we have no allowlist at all (the CLI
        requires one; a library caller might not pass one).
        """
        tools = [t for t in self.gateway_tools() if t.get("name") not in META_TOOLS]
        names = {t.get("name") for t in tools}
        keep = self.allowlist
        if keep is not None:
            missing = sorted(keep - names)
            if missing:
                log(
                    "gateway does not serve %d allowlisted tool(s): %s"
                    % (len(missing), ", ".join(missing))
                )
            if self.discovered is not None:
                foreign = sorted(keep & names - self.discovered)
                if foreign:
                    log(
                        "dropping %d allowlisted tool(s) that %s does not serve: %s"
                        % (len(foreign), self.server, ", ".join(foreign))
                    )
                keep = keep & self.discovered
        else:
            # No allowlist: nothing distinguishes our tools from anyone
            # else's, and exposing all of them would answer to
            # `mcp__<server>__<someone-elses-tool>`. The CLI makes --tools
            # required; this is the library-level backstop.
            log(
                "no --tools allowlist: cannot tell which of the gateway's %d "
                "tool(s) belong to %s. Exposing none." % (len(tools), self.server)
            )
            keep = frozenset()
        tools = [t for t in tools if t.get("name") in keep]
        self.exposed = {t.get("name") for t in tools}
        return tools

    # -- client side -----------------------------------------------------

    def handle(self, msg):
        """Return a JSON-RPC reply dict, or None for a notification."""
        method = msg.get("method")
        msg_id = msg.get("id")
        if method is None:
            return None
        if msg_id is None:  # notification: no reply, ever
            return None
        try:
            if method == "initialize":
                return self._ok(msg_id, self._initialize(msg.get("params") or {}))
            if method == "ping":
                return self._ok(msg_id, {})
            if method == "tools/list":
                self.ensure_connected()
                return self._ok(msg_id, {"tools": self.visible_tools()})
            if method == "tools/call":
                return self._ok(msg_id, self._call(msg.get("params") or {}))
            if method in ("resources/list", "prompts/list"):
                # Not advertised, but some clients ask anyway.
                key = "resources" if method.startswith("resources") else "prompts"
                return self._ok(msg_id, {key: []})
        except GatewayError as exc:
            log(str(exc))
            return self._err(msg_id, -32603, str(exc))
        return self._err(msg_id, -32601, "method not found: %s" % method)

    def _initialize(self, params):
        # Connect eagerly so a broken gateway shows up in Claude's MCP
        # status rather than as a mysteriously empty tool list -- but do
        # not fail the handshake, or the whole session dies with it.
        try:
            self.ensure_connected()
        except GatewayError as exc:
            log("initialize: %s" % exc)
        client = params.get("protocolVersion") or PROTOCOL_VERSION
        return {
            "protocolVersion": client,
            "capabilities": {"tools": {"listChanged": False}},
            "serverInfo": {
                "name": self.server,
                "version": "wmf-sbx-mcp-proxy/1",
            },
        }

    def _call(self, params):
        name = params.get("name")
        self.ensure_connected()
        if name not in self.exposed:
            self.visible_tools()  # refresh: the set can grow mid-session
        if name not in self.exposed:
            raise GatewayError("%s does not serve a tool named %r" % (self.server, name))
        return self.gw.call("tools/call", params)

    @staticmethod
    def _ok(msg_id, result):
        return {"jsonrpc": "2.0", "id": msg_id, "result": result}

    @staticmethod
    def _err(msg_id, code, message):
        return {
            "jsonrpc": "2.0",
            "id": msg_id,
            "error": {"code": code, "message": message},
        }


def serve(proxy, stdin, stdout):
    for line in stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except ValueError:
            log("ignoring unparseable line: %r" % line[:120])
            continue
        reply = proxy.handle(msg)
        if reply is not None:
            stdout.write(json.dumps(reply) + "\n")
            stdout.flush()


def parse_args(argv):
    parser = argparse.ArgumentParser(
        prog="wmf-sbx-mcp-proxy",
        description="Expose one sbx-gateway-hosted MCP server under its own name.",
    )
    parser.add_argument("server", help="server name as registered with `sbx mcp add`")
    parser.add_argument(
        "--tools",
        required=True,
        help="comma-separated allowlist of tool names (required: the "
        "gateway's namespace is flat, so nothing else tells us which "
        "tools belong to this server)",
    )
    parser.add_argument(
        "--no-add",
        action="store_true",
        help="skip `mcp-add` (server already mounted, e.g. --static-mcp)",
    )
    parser.add_argument(
        "--url",
        default=os.environ.get("MCP_GATEWAY_URL", DEFAULT_URL),
        help="gateway URL (default $MCP_GATEWAY_URL or the well-known one)",
    )
    args = parser.parse_args(argv)
    if args.tools is not None:
        args.tools = frozenset(t.strip() for t in args.tools.split(",") if t.strip())
    return args


def main(argv=None):
    args = parse_args(argv if argv is not None else sys.argv[1:])
    gateway = Gateway(args.url, os.environ.get("MCP_GATEWAY_AUTH", DEFAULT_AUTH))
    proxy = Proxy(
        args.server, gateway, allowlist=args.tools, try_add=not args.no_add
    )
    serve(proxy, sys.stdin, sys.stdout)
    return 0


if __name__ == "__main__":
    sys.exit(main())
