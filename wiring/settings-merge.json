{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(GIT_SEQUENCE_EDITOR=* git rebase:*)",
      "Bash(find:* -name*)",
      "Bash(find:* -type*)",
      "Bash(find:* -path*)",
      "Bash(find:* -maxdepth*)",
      "Bash(find:* -mindepth*)",
      "Bash(find:* -mtime*)",
      "Bash(find:* -newer*)",
      "Bash(find:* -print*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(curl:*)",
      "Bash(jq:*)"
    ],
    "deny": [
      "Bash(ssh:*)",
      "Bash(git config core.hooksPath:*)",
      "Bash(find:* -exec*)",
      "Bash(find:* -execdir*)",
      "Bash(find:* -delete*)",
      "Bash(find:* -ok*)",
      "Bash(find:* -okdir*)",
      "Bash(find:* -fprint*)",
      "Read(~/.ssh/*)",
      "Read(.git/config)",
      "Read(.git/credentials*)",
      "Read(**/*.env)",
      "Read(**/*.key)",
      "Read(**/*.secret)",
      "Read(**/*.credential)",
      "Read(**/*.pem)",
      "Edit(.claude/hooks/**)",
      "Edit(.claude/settings.json)",
      "Write(.claude/hooks/**)",
      "Write(.claude/settings.json)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/settings.local.json)",
      "Edit(~/.claude/hooks/**)",
      "Edit(~/.claude/plugins/**)",
      "Edit(~/.claude/agents/**)",
      "Edit(~/.claude/skills/**)",
      "Write(~/.claude/settings.json)",
      "Write(~/.claude/settings.local.json)",
      "Write(~/.claude/hooks/**)",
      "Write(~/.claude/plugins/**)",
      "Write(~/.claude/agents/**)",
      "Write(~/.claude/skills/**)"
    ],
    "ask": [
      "WebFetch"
    ]
  },
  "sandbox": {
    "enabled": false
  }
}
